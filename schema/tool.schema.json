{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "freestack tool",
  "type": "object",
  "required": ["id", "name", "kind", "url", "aisle", "metric", "who", "sell", "card", "pricing_url", "source"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "kind": { "type": "string", "maxLength": 40 },
    "url": { "type": "string", "format": "uri" },
    "aisle": { "type": "string" },
    "metric": { "type": ["number", "null"], "description": "Value in the aisle's headline unit. null means not listed." },
    "metric_note": { "type": "string", "description": "Required when metric is null or qualified, e.g. 'per database', 'no limit'." },
    "limits": { "type": "array", "items": { "type": "string" } },
    "who": { "type": "array", "minItems": 1, "items": { "enum": ["anyone", "student_any_id", "student_school_email", "startup_proof"] } },
    "region": { "type": ["string", "null"] },
    "sell": { "enum": ["yes", "no", "unknown"] },
    "card": { "enum": ["yes", "no", "unknown"], "description": "yes = card needed at signup" },
    "catches": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
    "use_if": { "type": "array", "items": { "type": "string" } },
    "skip_if": { "type": "array", "items": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string" }, "use": { "type": "string" } }, "additionalProperties": false } },
    "pricing_url": { "type": "string", "format": "uri" },
    "verified_at": { "type": ["string", "null"], "format": "date" },
    "verified_by": { "type": ["string", "null"] },
    "source": { "enum": ["catalog", "submitted", "imported"] }
  }
}
