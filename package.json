{
  "name": "@freestackhq/site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "deploy:cf": "node scripts/deploy.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "brand:og": "node scripts/brand/og.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "catalog:generate": "node scripts/generate.mjs",
    "import:lists": "node scripts/import-lists.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:workflows": "if command -v actionlint >/dev/null 2>&1; then actionlint; else echo \"lint:workflows: actionlint not installed, skipped (CI installs it: https://github.com/rhysd/actionlint)\"; fi",
    "review:shots": "node scripts/review/screenshots.mjs",
    "dns:freestack": "bash scripts/dns-freestack.sh",
    "cli": "node packages/cli/bin/freestack.js",
    "ops:link-check": "node scripts/ops/link-check.mjs",
    "ops:pricing-scan": "node scripts/ops/pricing-scan.mjs",
    "ops:staleness": "node scripts/ops/staleness-gate.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.166.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "^1.5.0"
    }
  }
}
