---
/** Word plus the 5-step scale against the aisle maximum. */
import type { ScaleResult } from "../../lib/fresh/label";

interface Props {
  scale: ScaleResult;
  /** Bar height in px. */
  bar?: number;
}
const { scale, bar = 12 } = Astro.props;
const filled = scale.kind === "step" ? scale.step : 0;
// Odd cases (Aisle.dc.html): "Not listed" or "Your own disk" as a small word, no steps.
const odd = scale.kind !== "step";
// One sentence for screen readers (DESIGN.md: every icon has a text equivalent).
const aria =
  scale.kind === "step"
    ? `${scale.word}: ${scale.step} of 5 on this aisle's scale.`
    : scale.kind === "unlimited"
      ? `No limit. ${scale.word}.`
      : "Not listed.";
---

<div class="scale" data-scale={scale.kind === "step" ? scale.step : scale.kind}>
  <p aria-hidden="true" class:list={["word", { odd, muted: scale.kind === "unknown" }]}>
    {scale.word}
  </p>
  {odd ? (
    <span class="sr-only">{aria}</span>
  ) : (
    <span role="img" aria-label={aria} class="steps">
      {[1, 2, 3, 4, 5].map((i) => (
        <span class:list={["step", { on: i <= filled }]} style={`height: ${bar}px`} />
      ))}
    </span>
  )}
</div>

<style>
  .scale {
    padding-bottom: 6px;
  }
  .word {
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.1;
    white-space: nowrap;
  }
  .word.odd {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    white-space: normal;
  }
  .word.muted {
    color: var(--muted);
  }
  .steps {
    display: flex;
    gap: 3px;
  }
  .step {
    flex: 1;
    background: var(--shelf);
  }
  .step.on {
    background: var(--ink);
  }
</style>
