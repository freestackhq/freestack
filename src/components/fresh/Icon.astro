---
/**
 * Board icons, drawn in currentColor. Always decorative (aria-hidden):
 * pair every icon with visible text or an .sr-only sentence.
 */
export type IconName =
  | "check"
  | "cross"
  | "wrench"
  | "card"
  | "card-none"
  | "card-unknown"
  | "search"
  | "chevron-down"
  | "chevron-up"
  | "back"
  | "close"
  | "menu"
  | "plus"
  | "external"
  | "unknown"
  | "filter";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 14, class: cls } = Astro.props;

const W: Record<IconName, number> = {
  check: 3.2,
  cross: 3.2,
  wrench: 2.6,
  card: 2.2,
  "card-none": 2.2,
  "card-unknown": 2.2,
  search: 2.2,
  "chevron-down": 3,
  "chevron-up": 3,
  back: 2.6,
  close: 3.2,
  menu: 2.2,
  plus: 3,
  external: 2.6,
  unknown: 2.4,
  filter: 2.6,
};
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={W[name]}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  style="flex: 0 0 auto"
>
  {name === "check" && <path d="M4 12.5l5 5L20 6.5" />}
  {(name === "cross" || name === "close") && <path d="M6 6l12 12M18 6L6 18" />}
  {name === "wrench" && (
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
  )}
  {name === "card" && (
    <>
      <rect x="2.5" y="5" width="19" height="14" rx="1.5" />
      <path d="M2.5 9.5h19" />
    </>
  )}
  {name === "card-none" && (
    <>
      <rect x="2.5" y="5" width="19" height="14" rx="1.5" />
      <path d="M2.5 9.5h19" />
      <path d="M3 21L21 3" stroke-width="2.6" />
    </>
  )}
  {name === "card-unknown" && (
    <g stroke-dasharray="3 2.4">
      <rect x="2.5" y="5" width="19" height="14" rx="1.5" />
      <path d="M2.5 9.5h19" />
    </g>
  )}
  {name === "search" && (
    <>
      <circle cx="11" cy="11" r="7" />
      <path d="M20 20l-3.5-3.5" />
    </>
  )}
  {name === "chevron-down" && <path d="M6 9l6 6 6-6" />}
  {name === "chevron-up" && <path d="M6 15l6-6 6 6" />}
  {name === "back" && <path d="M15 5l-7 7 7 7" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "external" && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === "unknown" && (
    <>
      <circle cx="12" cy="12" r="9.5" stroke-dasharray="3 3" />
      <path d="M9.6 9.4a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.2-2.4 3.7" />
      <path d="M12 17.2h.01" />
    </>
  )}
  {name === "filter" && <path d="M4 6h16M7 12h10M10 18h4" />}
</svg>
