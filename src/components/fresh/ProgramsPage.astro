---
/**
 * Claim Once aisle (Programs.dc.html), for every aisle in the Claim Once
 * group. Static page; the "I have" filter is
 * applied on the client from ?have= so the view stays shareable. The server
 * render applies the default so the page is correct without JavaScript.
 */
import Shell from "../../layouts/Shell.astro";
import Icon from "./Icon.astro";
import { now, programsInAisle, toolHref } from "../../lib/fresh/catalog";
import { labelState } from "../../lib/fresh/label";
import { DEFAULT_HAVE, HAVE_OPTIONS, canClaim } from "../../lib/fresh/programs";

import type { Aisle, Who } from "../../lib/fresh/types";

interface Props {
  aisle: Aisle;
}

const { aisle } = Astro.props;
const AISLE = aisle.id;
const programs = programsInAisle(AISLE);
// The "I have" filter only matters when some program needs proof you are a student.
const forStudents = programs.some((p) => p.who.some((w) => w.startsWith("student")));
const intro =
  aisle.intro ??
  "Bundles you claim once with a school email. They are numbered in the order worth claiming. The big number is how long it lasts.";
const source = AISLE === "student-programs" ? "the claim-order guide" : "the catalog";
const at = now();
const checked = programs.filter((p) => labelState(p, at) === "checked").length;
const visibleTo = (who: Who[]) => !forStudents || canClaim(who, DEFAULT_HAVE);
const shown = programs.filter((p) => visibleTo(p.who)).length;
const countText = (n: number) => `${n} ${n === 1 ? "program" : "programs"} you can claim`;
---

<Shell title={`${aisle.name} · freestack`} aisle={AISLE}>
  <div class="wrap page">
    <p class="crumbs"><a href="/">All aisles</a> <span aria-hidden="true">/</span> {aisle.group}</p>
    <div class="head">
      <h1 class="title-xl">{aisle.name}</h1>
      <p class="intro">{intro}</p>
    </div>

    {
      forStudents ? (
        <div class="filter" role="group" aria-labelledby="have-label" data-have-filter>
          <span id="have-label" class="have">I have</span>
          {HAVE_OPTIONS.map((o) => (
            <button type="button" class="chip" data-have={o.id} aria-pressed={String(o.id === DEFAULT_HAVE)}>
              {o.label}
            </button>
          ))}
          <p class="count" role="status" data-count>
            {countText(shown)}
          </p>
        </div>
      ) : (
        <div class="filter">
          <p class="count" role="status" data-count>
            {countText(shown)}
          </p>
        </div>
      )
    }

    <div class="grid" data-grid>
      {
        programs.map((t) => {
          const p = t.program!;
          return (
            <article
              class:list={["program", { first: p.order === 1 }]}
              data-program={t.id}
              data-order={p.order}
              data-who={t.who.join(" ")}
              hidden={!visibleTo(t.who)}
            >
              {p.order === 1 && <span class="tag">Claim first</span>}
              <div class="name">
                <span class="order" aria-hidden="true">
                  {p.order}
                </span>
                <h2 class="title">
                  <a href={toolHref(t)}>
                    <span class="sr-only">Number {p.order}: </span>
                    {t.name}
                  </a>
                </h2>
              </div>
              <p class="big">{p.lasts_big}</p>
              <p class="sub">{p.lasts_sub}</p>
              <ul class="perks">
                {p.perks.map((perk) => (
                  <li>{perk}</li>
                ))}
              </ul>
              <p class="needs">
                Needs: {p.needs}
                <br />
                Lasts: {p.lasts}
              </p>
              {t.catches[0] && (
                <p class="catch">
                  <Icon name="wrench" />
                  {t.catches[0]}
                </p>
              )}
              <a class="claim" href={p.claim_url} target="_blank" rel="noopener">
                How to claim it<span class="sr-only">: {t.name}, opens in a new tab</span>
              </a>
            </article>
          );
        })
      }
    </div>

    <div class="empty" data-empty hidden={shown > 0}>
      <p class="empty-title">Every program here needs proof you are a student.</p>
      <p>A school email gets you the most. Free tools anyone can use are in the other aisles.</p>
      <div class="empty-actions">
        <button type="button" class="btn" data-have-set="school">Show programs for a school email</button>
        <a class="btn btn-outline" href="/">All aisles</a>
      </div>
    </div>

    <p class="note" data-note>
      Order and terms from {source}.
      {
        checked === 0
          ? " Not checked against each vendor yet."
          : ` ${checked} of ${programs.length} checked against the vendor's page.`
      }
    </p>
  </div>
</Shell>

<script>
  import { canClaim, parseHave, type Have } from "../../lib/fresh/programs";
  import type { Who } from "../../lib/fresh/types";

  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-program]"));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-have]"));
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const count = document.querySelector<HTMLElement>("[data-count]");

  function apply(have: Have) {
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.have === have)));
    let n = 0;
    cards.forEach((c) => {
      const ok = canClaim((c.dataset.who ?? "").split(" ") as Who[], have);
      c.hidden = !ok;
      if (ok) n++;
    });
    if (empty) empty.hidden = n > 0;
    if (count) count.textContent = `${n} ${n === 1 ? "program" : "programs"} you can claim`;
  }

  function choose(have: Have) {
    const url = new URL(location.href);
    url.searchParams.set("have", have);
    history.replaceState(null, "", url);
    apply(have);
  }

  buttons.forEach((b) => b.addEventListener("click", () => choose(parseHave(b.dataset.have))));
  document.querySelectorAll<HTMLButtonElement>("[data-have-set]").forEach((b) =>
    b.addEventListener("click", () => {
      const have = parseHave(b.dataset.haveSet);
      choose(have);
      buttons.find((x) => x.dataset.have === have)?.focus();
    }),
  );

  // Aisles with no student-only program have no filter: show every card.
  if (document.querySelector("[data-have-filter]")) apply(parseHave(new URLSearchParams(location.search).get("have")));
</script>

<style>
  .page {
    padding-block: 40px 96px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-end;
  }
  .head h1 {
    flex: 1 1 520px;
  }
  .intro {
    flex: 0 1 400px;
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }
  .filter {
    position: sticky;
    top: 0;
    z-index: 2;
    margin-top: 28px;
    padding: 14px 0;
    background: var(--shelf);
    border-bottom: 2px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .have {
    font-size: 15px;
    font-weight: 700;
    margin-right: 6px;
  }
  .filter .chip {
    font-weight: 700;
  }
  .count {
    margin: 0 0 0 auto;
    font-size: 14px;
    color: var(--muted);
  }
  .grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  .program {
    position: relative;
    background: var(--label);
    border-top: 8px solid var(--ink);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .program.first {
    border-top-color: var(--promo);
  }
  .tag {
    position: absolute;
    top: -10px;
    right: 16px;
    background: var(--promo);
    color: var(--ink);
    font-weight: 800;
    font-size: 14px;
    padding: 8px 12px 6px;
    box-shadow: 0 2px 0 var(--promo-shadow);
  }
  .name {
    padding: 16px 18px 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .order {
    font-weight: 900;
    font-stretch: 62%;
    font-size: 28px;
    line-height: 1;
    color: var(--muted);
  }
  .title {
    margin: 0;
    font-size: 19px;
    font-weight: 800;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .big {
    margin: 6px 18px 0;
    font-weight: 900;
    font-stretch: 62%;
    font-size: 64px;
    line-height: 1.05;
  }
  .sub {
    margin: 6px 18px 0;
    font-size: 14px;
    color: var(--muted);
  }
  .perks {
    flex: 1;
    margin: 12px 18px 0;
    padding: 10px 0 0 18px;
    border-top: 1px solid var(--ink);
    font-size: 15px;
    line-height: 1.3;
    display: grid;
    align-content: start;
    gap: 3px;
  }
  .needs {
    margin: 14px 0 0;
    padding: 10px 18px;
    background: var(--fill);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
  }
  .catch {
    margin: 0;
    padding: 8px 18px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    border-top: 1px solid var(--shelf);
  }
  .claim {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target);
    border-top: 1px solid var(--shelf);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }
  .claim:hover {
    text-decoration: underline;
  }
  .claim:focus-visible {
    outline-offset: -3px;
  }
  .empty {
    margin-top: 32px;
    max-width: 640px;
    background: var(--label);
    padding: 24px;
  }
  .empty p {
    margin: 0 0 8px;
  }
  .empty-title {
    font-weight: 800;
    font-size: 19px;
  }
  .empty-actions {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .note {
    margin: 32px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .page {
      padding-block: 28px 64px;
    }
    .count {
      margin-left: 0;
      flex-basis: 100%;
    }
    /* Three rows of chips would cover too much of a phone screen. */
    .filter {
      position: static;
    }
  }
</style>
