---
/**
 * Search overlay (Search.dc.html, PhoneSearch.dc.html; no results in
 * Edges.dc.html). Opens on the window event `fs:search-open` (header
 * buttons), Ctrl K, ⌘K and "/" (not while typing in a field). Esc closes
 * and returns focus to where it was.
 *
 * Results come from a small JSON index built at render time from catalog.ts
 * (search-index.ts). `findResults` in the script below is the one function
 * Pagefind replaces.
 */
import Icon from "./Icon.astro";
import { buildSearchIndex } from "../../lib/fresh/search-index";

const index = buildSearchIndex();
---

<dialog id="search-dialog" class="search" aria-label="Search" data-search-dialog>
  <div class="panel">
    <div class="bar">
      <button type="button" class="icon-btn phone-only" aria-label="Close search" data-search-close>
        <Icon name="back" size={16} />
      </button>
      <span class="glass desktop-only"><Icon name="search" size={22} /></span>
      <label for="search-input" class="sr-only">Search tools, catches and aisles</label>
      <input
        id="search-input"
        type="text"
        inputmode="search"
        enterkeyhint="go"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        data-search-input
      />
      <button type="button" class="icon-btn phone-only" aria-label="Clear search" data-search-clear hidden>
        <Icon name="close" size={14} />
      </button>
      <button type="button" class="esc desktop-only" aria-label="Close search" data-search-close>
        <kbd>Esc</kbd>
      </button>
    </div>

    <p class="hint muted" data-search-hint>Type a tool, a catch or an aisle.</p>
    <ul id="search-results" role="listbox" aria-label="Results" data-search-results></ul>
    <div class="nothing" role="status" data-search-empty></div>

    <div class="keys desktop-only" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>Enter</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>

  <template data-search-icons>
    <span data-icon="yes"><Icon name="check" /></span>
    <span data-icon="no"><Icon name="cross" /></span>
    <span data-icon="unknown"><Icon name="unknown" /></span>
    <span data-icon="wrench"><Icon name="wrench" /></span>
  </template>
  <script type="application/json" data-search-index set:html={JSON.stringify(index).replace(/</g, "\\u003c")} />
</dialog>

<style>
  .search {
    width: min(640px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 120px);
    margin: 96px auto auto;
    padding: 0;
    border: 0;
    background: var(--label);
    color: var(--ink);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  .search::backdrop {
    background: rgba(28, 35, 64, 0.55);
  }
  .search[open] {
    display: flex;
  }
  .panel {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .bar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 64px;
    padding: 0 12px 0 20px;
    border-bottom: 2px solid var(--ink);
  }
  .glass {
    display: flex;
    flex: 0 0 auto;
  }
  .bar input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 600 22px var(--font);
  }
  .bar input:focus-visible {
    outline: 0;
  }
  /* The input has no outline of its own: the bar's bottom rule shows focus. */
  .bar:focus-within {
    border-bottom-color: var(--focus);
  }
  .icon-btn,
  .esc {
    flex: 0 0 auto;
    min-width: var(--target);
    height: var(--target);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--ink);
    cursor: pointer;
  }
  .phone-only {
    display: none;
  }
  .hint {
    margin: 0;
    padding: 18px 20px;
    font-size: 15px;
  }

  [role="listbox"] {
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
    flex: 1 1 auto;
    min-height: 0;
    max-height: 560px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  [role="listbox"]:empty {
    display: none;
  }
  .search :global(.group-h) {
    margin: 0;
    padding: 14px 20px 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }
  .search :global(.group) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .search :global(.row) {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 10px 20px;
    background: var(--label);
    color: var(--ink);
    text-decoration: none;
  }
  .search :global(.row[aria-selected="true"]) {
    background: color-mix(in srgb, var(--promo) 22%, var(--label));
    box-shadow: inset 4px 0 0 var(--ink);
  }
  .search :global(.text) {
    min-width: 0;
  }
  .search :global(.title) {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 700;
  }
  .search :global(.sub) {
    display: -webkit-box;
    margin-top: 2px;
    font-size: 14px;
    color: var(--muted);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search :global(.side) {
    margin-left: auto;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    font-weight: 700;
  }
  .search :global(.side.unsure) {
    font-weight: 600;
    color: var(--muted);
  }

  .nothing:empty {
    display: none;
  }
  .nothing {
    display: grid;
    gap: 8px;
    padding: 22px 20px 24px;
  }
  .nothing :global(p) {
    margin: 0;
    font-size: 16px;
  }
  .nothing :global(.lead) {
    font-size: 18px;
    font-weight: 800;
  }
  .nothing :global(.add) {
    font-size: 15px;
    color: var(--muted);
  }
  .nothing :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    font-weight: 700;
  }

  .keys {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding: 12px 20px;
    border-top: 1px solid var(--shelf);
    font-size: 13px;
    color: var(--muted);
  }
  .keys span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* ----- Phone: full screen ----- */
  @media (max-width: 760px) {
    .search {
      width: 100vw;
      height: 100dvh;
      max-height: none;
      margin: 0;
      inset: 0;
      background: var(--shelf);
      box-shadow: none;
    }
    .phone-only {
      display: flex;
    }
    .phone-only[hidden] {
      display: none;
    }
    .desktop-only {
      display: none;
    }
    .bar {
      height: 60px;
      gap: 6px;
      padding: 0 8px;
      background: var(--label);
    }
    .bar input {
      font-size: 19px;
    }
    .hint {
      padding: 16px;
    }
    [role="listbox"] {
      max-height: none;
    }
    .search :global(.group-h) {
      padding: 14px 16px 6px;
    }
    .search :global(.group) {
      display: grid;
      gap: 1px;
    }
    .search :global(.row) {
      gap: 10px;
      padding: 8px 16px;
    }
    .nothing {
      padding: 20px 16px;
      background: var(--label);
    }
  }
</style>

<script>
  import { didYouMean, searchLocal, type SearchEntry, type SearchResultGroup } from "../../lib/fresh/search";

  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]")!;
  const input = dialog.querySelector<HTMLInputElement>("[data-search-input]")!;
  const list = dialog.querySelector<HTMLUListElement>("[data-search-results]")!;
  const empty = dialog.querySelector<HTMLElement>("[data-search-empty]")!;
  const hint = dialog.querySelector<HTMLElement>("[data-search-hint]")!;
  const clear = dialog.querySelector<HTMLButtonElement>("[data-search-clear]")!;
  const icons = dialog.querySelector<HTMLTemplateElement>("[data-search-icons]")!.content;
  const INDEX: SearchEntry[] = JSON.parse(dialog.querySelector("[data-search-index]")!.textContent || "[]");

  /**
   * The one search call. Pagefind replaces this: same input, same grouped
   * output (catches, tools, aisles; empty groups left out).
   */
  async function findResults(query: string): Promise<SearchResultGroup[]> {
    return searchLocal(INDEX, query);
  }

  let opener: HTMLElement | null = null;
  let active = -1;
  let options: HTMLElement[] = [];
  let seq = 0;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  function icon(name: string): string {
    return icons.querySelector(`[data-icon="${name}"]`)?.innerHTML ?? "";
  }

  const SELL: Record<string, { text: string; sr: string; unsure?: boolean }> = {
    yes: { text: "Can sell", sr: "You can sell with it." },
    no: { text: "No selling", sr: "Selling with it is not allowed." },
    unknown: { text: "Check terms", sr: "Not known if you can sell with it.", unsure: true },
  };

  function row(e: SearchEntry, id: string): string {
    let side = "";
    if (e.read) side = `<span class="side">Read</span>`;
    else if (e.sell) {
      const s = SELL[e.sell];
      side = `<span class="side${s.unsure ? " unsure" : ""}">${icon(e.sell)}<span aria-hidden="true">${s.text}</span><span class="sr-only">${s.sr}</span></span>`;
    }
    const wrench = e.group === "catches" ? icon("wrench") : "";
    // The link is the option itself: an option must not hold a link.
    return `<li role="presentation"><a role="option" id="${id}" aria-selected="false" class="row" href="${esc(e.href)}" tabindex="-1"><span class="text"><span class="title">${wrench}${esc(e.title)}</span><span class="sub">${esc(e.sub)}</span></span>${side}</a></li>`;
  }

  function setActive(i: number) {
    if (!options.length) {
      active = -1;
      input.removeAttribute("aria-activedescendant");
      return;
    }
    active = (i + options.length) % options.length;
    options.forEach((o, n) => o.setAttribute("aria-selected", String(n === active)));
    const el = options[active];
    input.setAttribute("aria-activedescendant", el.id);
    el.scrollIntoView({ block: "nearest" });
  }

  async function render() {
    const q = input.value;
    const mine = ++seq;
    const groups = await findResults(q);
    if (mine !== seq) return;
    clear.hidden = q.length === 0;
    hint.hidden = q.trim().length > 0;

    let n = 0;
    list.innerHTML = groups
      .map((g) => {
        const hid = `search-g-${g.group}`;
        const items = g.items.map((e) => row(e, `search-opt-${n++}`)).join("");
        return `<li role="presentation"><p class="group-h" id="${hid}">${g.label}</p><ul class="group" role="group" aria-labelledby="${hid}">${items}</ul></li>`;
      })
      .join("");
    options = Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));
    input.setAttribute("aria-expanded", String(options.length > 0));
    setActive(0);

    if (q.trim() && options.length === 0) {
      const near = didYouMean(INDEX, q);
      const quoted = esc(q.trim());
      empty.innerHTML =
        `<p class="lead">Nothing matches "${quoted}"</p>` +
        (near ? `<p>Did you mean <a href="${esc(near.href)}">${esc(near.title)}</a>?</p>` : "") +
        `<p class="add">Not on freestack yet? <a href="/add?name=${encodeURIComponent(q.trim())}">Add it</a></p>`;
    } else {
      empty.innerHTML = "";
    }
  }

  function open() {
    if (dialog.open) {
      input.focus();
      return;
    }
    opener = document.activeElement instanceof HTMLElement && document.activeElement !== document.body
      ? document.activeElement
      : null;
    dialog.showModal();
    document.documentElement.style.overflow = "hidden";
    input.focus();
    input.select();
    render();
  }

  function close() {
    if (!dialog.open) return;
    dialog.close();
  }

  dialog.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
    if (opener && opener.isConnected) opener.focus();
    opener = null;
  });

  // Esc: let the dialog's own cancel close it, but keep it from clearing anything first.
  dialog.addEventListener("cancel", (e) => {
    e.preventDefault();
    close();
  });

  // A click on the backdrop lands on the <dialog> itself.
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) close();
  });

  dialog.querySelectorAll("[data-search-close]").forEach((b) => b.addEventListener("click", close));
  clear.addEventListener("click", () => {
    input.value = "";
    render();
    input.focus();
  });

  input.addEventListener("input", render);
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === "Home" && options.length && e.ctrlKey) {
      e.preventDefault();
      setActive(0);
    } else if (e.key === "End" && options.length && e.ctrlKey) {
      e.preventDefault();
      setActive(options.length - 1);
    } else if (e.key === "Enter") {
      const a = options[active] as HTMLAnchorElement | undefined;
      if (a) {
        e.preventDefault();
        a.click();
      }
    } else if (e.key === "Escape") {
      e.preventDefault();
      close();
    }
  });

  list.addEventListener("mousemove", (e) => {
    const opt = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    if (!opt) return;
    const i = options.indexOf(opt);
    if (i >= 0 && i !== active) setActive(i);
  });

  window.addEventListener("fs:search-open", open);

  function typing(el: EventTarget | null): boolean {
    if (!(el instanceof HTMLElement)) return false;
    return el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName);
  }

  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === "k") {
      e.preventDefault();
      open();
      return;
    }
    if (e.key === "/" && !e.ctrlKey && !e.metaKey && !e.altKey && !typing(e.target) && !dialog.open) {
      e.preventDefault();
      open();
    }
  });
</script>
