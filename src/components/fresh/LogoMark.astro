---
/** The shelf-tag mark from public/brand/logo-mark.svg. Decorative. */
interface Props {
  size?: number;
  /** "default" = yellow tag on navy; "outlined" = yellow tag with ink outline; "inverse" = navy tag. */
  variant?: "default" | "outlined" | "inverse";
}
const { size = 30, variant = "default" } = Astro.props;
const tag = variant === "inverse" ? "var(--ink)" : "var(--promo)";
const marks = variant === "inverse" ? "var(--promo)" : "var(--ink)";
---

<svg aria-hidden="true" width={size} height={size} viewBox="0 0 40 40" style="flex: 0 0 auto">
  <path
    d="M2.5 20L11 7.5h26.5v25H11z"
    fill={tag}
    stroke={variant === "outlined" ? "var(--ink)" : undefined}
    stroke-width={variant === "outlined" ? 2.5 : undefined}
    stroke-linejoin="round"
  />
  <circle cx="11.5" cy="20" r="2.8" fill={marks} />
  <rect x="18" y="12.5" width="15" height="3.6" fill={marks} />
  <rect x="18" y="18.2" width="11.5" height="3.6" fill={marks} />
  <rect x="18" y="23.9" width="8" height="3.6" fill={marks} />
</svg>
