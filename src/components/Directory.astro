---
import { CATALOGS, entryField, filterOptions } from "../lib/catalog";

/**
 * Generic multi-catalog directory. Renders every catalog's categories and
 * entries from the generated snapshot. Catalog tabs switch the active
 * catalog; category + field filters and search operate on the active one.
 */

interface Props {
  defaultCatalog?: string;
}

const { defaultCatalog } = Astro.props;

const catalogConfig = CATALOGS.map((c) => ({
  id: c.id,
  label: c.label,
  description: c.description,
  categories: c.categories.map((cat) => ({
    id: cat.id,
    label: cat.label,
    count: cat.entries.length,
  })),
  filters: (c.filters ?? []).map((f) => ({
    key: f.key,
    label: f.label,
    kind: f.kind,
    options: filterOptions(c, f.key, f.kind),
  })),
}));

const needPresets: Record<string, { catalog: string; category: string; label: string; note: string }> = {
  hosting: {
    catalog: "saas",
    category: "hosting",
    label: "Host a web app",
    note: "Compare deploy targets, bandwidth, and commercial terms before you commit.",
  },
  databases: {
    catalog: "saas",
    category: "databases",
    label: "Store data",
    note: "Start with the storage model and limits your project can actually live with.",
  },
  auth: {
    catalog: "saas",
    category: "auth",
    label: "Add authentication",
    note: "Compare user, session, and secret-management constraints in one place.",
  },
  email: {
    catalog: "saas",
    category: "email",
    label: "Send email",
    note: "Check delivery quotas, form support, and the point where free stops being enough.",
  },
  weather: {
    catalog: "apis",
    category: "weather",
    label: "Use a public API",
    note: "Compare authentication, CORS, status, and rate-limit tradeoffs.",
  },
  inference: {
    catalog: "llm-ai",
    category: "inference",
    label: "Run AI",
    note: "Compare model access, compatibility, and usage constraints before integrating.",
  },
};

const initialNeed = Astro.url.searchParams.get("need");
const initialPreset = initialNeed ? needPresets[initialNeed] : null;
const requestedCatalog = Astro.url.searchParams.get("catalog");
const catalogFromQuery = initialPreset?.catalog ?? requestedCatalog;
const initialCatalogId = catalogConfig.some((c) => c.id === catalogFromQuery)
  ? (catalogFromQuery as string)
  : (defaultCatalog ?? catalogConfig[0].id);
const initialCategories = new Set(
  [
    ...Astro.url.searchParams.getAll("category"),
    Astro.url.searchParams.get("hint") ?? "",
  ].filter((id) => catalogConfig.find((c) => c.id === initialCatalogId)?.categories.some((cat) => cat.id === id)),
);
if (initialPreset?.catalog === initialCatalogId) initialCategories.add(initialPreset.category);
const decisionNeed = initialPreset?.label ?? null;
const decisionNote = initialPreset?.note ?? null;
const initialCommercial = Astro.url.searchParams.get("commercial") === "yes";
---

<script type="application/json" id="catalog-config-data" set:html={JSON.stringify(catalogConfig)}></script>
<script type="application/json" id="need-presets-data" set:html={JSON.stringify(needPresets)}></script>

<section id="directory" class="pb-24">
  <div class="ds-wrap pt-8 sm:pt-12">
    <div id="decision-summary" class:list={["border-y border-sand/60 bg-s1 px-4 py-4 sm:px-5", !decisionNeed && "hidden"]}>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-sand">Your decision path</p>
          <h2 class="mt-2 text-xl font-semibold tracking-[-0.02em] text-ink">
            <span data-decision-title>{decisionNeed}</span>
          </h2>
          <p class="mt-1 max-w-2xl text-sm leading-6 text-ink-2" data-decision-note>{decisionNote}</p>
        </div>
        <div class="flex shrink-0 gap-2">
          <button type="button" id="share-decision" class="ds-btn ds-btn-outline">copy result link</button>
          <a href="/#directory" class="ds-btn ds-btn-outline">start over</a>
        </div>
      </div>
      <p id="share-message" class="mt-3 hidden font-mono text-[0.68rem] text-ok" role="status" aria-live="polite"></p>
    </div>
  </div>

  <div
    id="filters"
    class="sticky top-[var(--nav-h)] z-40 border-b border-b1 bg-[#0d0c0bf2] py-3 backdrop-blur-md supports-[backdrop-filter]:bg-[#0d0c0be8]"
  >
    <div class="ds-wrap">
      <div class="flex flex-col gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <div class="ds-switch" data-catalog-group role="group" aria-label="Catalog">
            {
              catalogConfig.map((c) => (
                <button
                  type="button"
                  class:list={["ds-chip", c.id === initialCatalogId && "is-active"]}
                  data-catalog-tab={c.id}
                  aria-pressed={c.id === initialCatalogId ? "true" : "false"}
                >
                  {c.label}
                </button>
              ))
            }
          </div>
          <p class="font-mono text-[0.72rem] text-ink-3">
            <span data-catalog-desc>{catalogConfig.find((c) => c.id === initialCatalogId)?.description}</span>
          </p>
        </div>

        <div class="relative flex min-w-0 items-center gap-2">
          <label class="relative block min-w-0 flex-1">
            <span class="sr-only">Search entries</span>
            <input
              id="q"
              type="search"
              placeholder="Search entries…"
              class="ds-input"
            />
          </label>

          <button
            type="button"
            id="filters-toggle"
            class="ds-chip shrink-0 px-3.5 py-[7px] text-[0.75rem]"
            aria-expanded="false"
            aria-controls="filters-popover"
            title="Open filters"
          >
            filters
            <span id="filters-active-mark" class="hidden text-sand">·</span>
          </button>

          <div
            id="filters-popover"
            class="filter-popover absolute top-[calc(100%+8px)] right-0 left-0 z-50 sm:left-auto sm:w-[22rem] rounded-[var(--radius)] border border-b2 bg-s2 p-4 shadow-[0_12px_40px_rgba(0,0,0,0.45)]"
            role="group"
            aria-label="Directory filters"
          >
            <div class="mb-3 flex items-center justify-between gap-3">
              <p class="font-mono text-[0.68rem] tracking-wide text-ink-3 uppercase">
                Categories
              </p>
              <button
                type="button"
                id="categories-clear"
                class="font-mono text-[0.68rem] text-ink-3 underline-offset-2 hover:text-ink-2 hover:underline"
              >
                show all
              </button>
            </div>
            <div
              class="ds-switch max-h-40 overflow-y-auto"
              data-category-group
              role="group"
              aria-label="Categories"
            >
              {
                catalogConfig.find((c) => c.id === initialCatalogId)?.categories.map((cat) => (
                  <button
                    type="button"
                    class:list={[
                      "ds-chip",
                      initialCategories.has(cat.id) && "is-active",
                    ]}
                    data-category-chip={cat.id}
                    aria-pressed={initialCategories.has(cat.id) ? "true" : "false"}
                  >
                    {cat.label}
                  </button>
                ))
              }
            </div>

            {
              catalogConfig.find((c) => c.id === initialCatalogId)?.filters.map((f) => (
                <div key={f.key} data-filter-block={f.key} class="filter-block">
                  <p class="mt-4 mb-2 font-mono text-[0.68rem] tracking-wide text-ink-3 uppercase">
                    {f.label}
                  </p>
                  <div
                    class="ds-switch"
                    data-filter-group={f.key}
                    role="group"
                    aria-label={f.label}
                  >
                    {f.options.map((opt) => (
                      <button
                        type="button"
                        class="ds-chip"
                        data-value={opt}
                        aria-pressed="false"
                      >
                        {opt}
                      </button>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <p id="count" class="font-mono text-[0.72rem] text-ink-3">
            {catalogConfig.find((c) => c.id === initialCatalogId)?.categories.reduce(
              (n, cat) => n + cat.count,
              0,
            )}{" "}
            entries
          </p>
          <p id="active-constraints" class="hidden font-mono text-[0.68rem] text-ink-2" aria-live="polite"></p>
          <p id="commercial-note" class="hidden font-mono text-[0.68rem] text-sand" role="status">commercial use requested</p>
        </div>
      </div>
    </div>
  </div>

  <div class="ds-wrap">
    <div id="empty" class="mt-16 hidden text-center">
      <p class="text-ink-2">Nothing matches. Loosen a filter.</p>
    </div>

    {
      CATALOGS.map((c) => (
        <div
          class:list={["catalog-panels", c.id === initialCatalogId ? "" : "is-hidden"]}
          data-catalog-panels={c.id}
          hidden={c.id !== initialCatalogId}
        >
          {c.categories.map((cat) => {
            const items = cat.entries;
            if (!items.length) return null;
            const startHidden = initialCategories.size > 0 && !initialCategories.has(cat.id);
            const f = catalogConfig.find((x) => x.id === c.id)?.filters ?? [];
            return (
              <section
                class:list={["cat-panel mt-12", startHidden && "is-hidden"]}
                data-category={cat.id}
                hidden={startHidden}
              >
                <div class="ds-section-label !mb-6">
                  <span class="ds-section-name">{cat.label}</span>
                  <span class="ds-hairline flex-1" />
                  <span class="font-mono text-[0.72rem] text-ink-3 cat-count">{items.length}</span>
                </div>
                <ul class="divide-y divide-b1 border-y border-b1" role="list">
                  {items.map((e) => {
                    const haystack = [
                      e.name,
                      ...Object.values(e.fields),
                      ...e.prose,
                      ...e.alternatives.map((a) => `${a.name} ${a.text}`),
                    ]
                      .join(" ")
                      .toLowerCase();
                    return (
                      <li
                        class="entry-row group"
                        data-entry
                        data-haystack={haystack}
                        data-catalog={c.id}
                        data-category={cat.id}
                        {...Object.fromEntries(
                          f.map((x) => [
                            `data-f-${x.key}`,
                            entryField(e, x.key).toLowerCase(),
                          ]),
                        )}
                      >
                        <a
                          href={`/catalogs/${c.id}/${cat.id}/${e.slug}`}
                          class="block px-2 py-4 sm:px-4"
                        >
                          <div class="min-w-0">
                            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                              <span class="ds-tool-name">{e.name}</span>
                              <span class="font-mono text-[0.68rem] text-ink-3">↗</span>
                            </div>
                            <p class="mt-1 text-[0.92rem] leading-relaxed text-ink-2">
                              {e.pick || e.prose[0] || ""}
                            </p>
                          </div>
                          <div class="mt-2 flex flex-wrap gap-1.5 sm:justify-end">
                            {f.map((x) => (
                              <span class="ds-badge" key={x.key}>
                                {entryField(e, x.key)}
                              </span>
                            ))}
                          </div>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </section>
            );
          })}
        </div>
      ))
    }
  </div>
</section>

<style>
  .entry-row.is-hidden {
    display: none;
  }
  .cat-panel.is-hidden,
  .cat-panel[hidden] {
    display: none;
  }
  .catalog-panels.is-hidden,
  .catalog-panels[hidden] {
    display: none;
  }
  .filter-popover:not(.is-open) {
    display: none;
  }
  .filter-popover.is-open {
    display: block;
  }
</style>

<script>
  const CATALOG_CONFIG = JSON.parse(
    document.getElementById("catalog-config-data")?.textContent ?? "[]",
  );

  const state = {
    catalog: document.querySelector("[data-catalog-tab].is-active")?.dataset.catalogTab ?? "",
    categories: new Set<string>([]),
    q: "",
    filters: {} as Record<string, Set<string>>,
  };

  const NEED_PRESETS = JSON.parse(
    document.getElementById("need-presets-data")?.textContent ?? "{}",
  ) as Record<string, { catalog: string; category: string; label: string; note: string }>;
  const requestedNeed = new URLSearchParams(window.location.search).get("need") ?? "";
  const params = new URLSearchParams(window.location.search);
  const requestedPreset = NEED_PRESETS[requestedNeed];
  const requestedCommercial = params.get("commercial") === "yes";
  const requestedHint = params.get("hint") ?? "";

  if (requestedPreset) {
    state.catalog = requestedPreset.catalog;
    state.categories.add(requestedPreset.category);
  }
  if (requestedCommercial) {
    state.filters.commercial = new Set(["commercial ok"]);
  }
  for (const id of [...params.getAll("category"), requestedHint]) {
    if (CATALOG_CONFIG.find((c: any) => c.id === state.catalog)?.categories.some((c: any) => c.id === id)) {
      state.categories.add(id);
    }
  }
  state.q = (params.get("q") ?? "").trim().toLowerCase();

  const rows = [...document.querySelectorAll<HTMLElement>(".entry-row")];
  const panels = [...document.querySelectorAll<HTMLElement>(".cat-panel")];
  const catalogPanels = [...document.querySelectorAll<HTMLElement>("[data-catalog-panels]")];
  const countEl = document.getElementById("count");
  const emptyEl = document.getElementById("empty");
  const qInput = document.getElementById("q") as HTMLInputElement | null;
  const popover = document.getElementById("filters-popover");
  const toggle = document.getElementById("filters-toggle");
  const activeMark = document.getElementById("filters-active-mark");
  const commercialNote = document.getElementById("commercial-note");
  const activeConstraints = document.getElementById("active-constraints");
  const catalogDesc = document.querySelector("[data-catalog-desc]");
  const catalogTabs = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-catalog-tab]"),
  ];

  function catalogConfigFor(id: string) {
    return CATALOG_CONFIG.find((c: any) => c.id === id) ?? CATALOG_CONFIG[0];
  }

  function bindChips() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-category-chip]")
      .forEach((chip) => {
        chip.onclick = () => {
          const id = chip.dataset.categoryChip ?? "";
          toggleCategory(id);
        };
      });
    document
      .querySelectorAll<HTMLButtonElement>("[data-filter-group] .ds-chip")
      .forEach((chip) => {
        chip.onclick = () => {
          const key = chip.closest("[data-filter-group]")?.getAttribute("data-filter-group") ?? "";
          const value = chip.dataset.value ?? "";
          toggleFilter(key, value);
        };
      });
  }

  function rebuildFiltersUI() {
    const cfg = catalogConfigFor(state.catalog);
    // Category chips
    const catGroup = document.querySelector("[data-category-group]");
    if (catGroup) {
      catGroup.innerHTML = "";
      for (const cat of cfg.categories) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "ds-chip";
        btn.dataset.categoryChip = cat.id;
        btn.setAttribute("aria-pressed", "false");
        btn.textContent = cat.label;
        catGroup.appendChild(btn);
      }
    }
    // Filter groups
    document.querySelectorAll(".filter-block").forEach((el) => el.remove());
    const popoverRoot = popover;
    if (popoverRoot) {
      for (const f of cfg.filters) {
        const block = document.createElement("div");
        block.className = "filter-block";
        block.dataset.filterBlock = f.key;
        const label = document.createElement("p");
        label.className = "mt-4 mb-2 font-mono text-[0.68rem] tracking-wide text-ink-3 uppercase";
        label.textContent = f.label;
        const group = document.createElement("div");
        group.className = "ds-switch";
        group.dataset.filterGroup = f.key;
        group.setAttribute("role", "group");
        group.setAttribute("aria-label", f.label);
        for (const opt of f.options) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "ds-chip";
          btn.dataset.value = opt;
          btn.setAttribute("aria-pressed", "false");
          btn.textContent = opt;
          group.appendChild(btn);
        }
        block.appendChild(label);
        block.appendChild(group);
        popoverRoot.appendChild(block);
      }
    }
    if (catalogDesc) catalogDesc.textContent = cfg.description;
    bindChips();
  }

  function toggleCategory(id: string) {
    if (state.categories.has(id)) state.categories.delete(id);
    else state.categories.add(id);
    syncCategoryChips();
    apply();
  }

  function toggleFilter(key: string, value: string) {
    if (!state.filters[key]) state.filters[key] = new Set();
    const s = state.filters[key];
    if (s.has(value)) s.delete(value);
    else s.add(value);
    syncFilterChips();
    apply();
  }

  function syncCategoryChips() {
    document.querySelectorAll<HTMLButtonElement>("[data-category-chip]").forEach((chip) => {
      const id = chip.dataset.categoryChip ?? "";
      const on = state.categories.has(id);
      chip.classList.toggle("is-active", on);
      chip.setAttribute("aria-pressed", on ? "true" : "false");
    });
  }

  function syncFilterChips() {
    document.querySelectorAll<HTMLButtonElement>("[data-filter-group] .ds-chip").forEach((chip) => {
      const key = chip.closest("[data-filter-group]")?.getAttribute("data-filter-group") ?? "";
      const value = chip.dataset.value ?? "";
      const on = state.filters[key]?.has(value) ?? false;
      chip.classList.toggle("is-active", on);
      chip.setAttribute("aria-pressed", on ? "true" : "false");
    });
  }

  function filtersDirty() {
    return state.categories.size > 0 || Object.values(state.filters).some((s) => s.size > 0);
  }

  function updateActiveConstraints() {
    if (!activeConstraints) return;
    const cfg = catalogConfigFor(state.catalog);
    const labels = [
      ...[...state.categories].map((id) => cfg.categories.find((category: any) => category.id === id)?.label ?? id),
      ...Object.entries(state.filters).flatMap(([key, values]) =>
        [...values].map((value) => `${cfg.filters.find((filter: any) => filter.key === key)?.label ?? key}: ${value}`),
      ),
    ];
    activeConstraints.textContent = labels.length ? `Showing: ${labels.join(" · ")}` : "";
    activeConstraints.classList.toggle("hidden", labels.length === 0);
  }

  function syncUrl() {
    const url = new URL(window.location.href);
    url.searchParams.set("catalog", state.catalog);
    if (
      requestedNeed &&
      requestedPreset &&
      state.catalog === requestedPreset.catalog &&
      state.categories.has(requestedPreset.category)
    ) {
      url.searchParams.set("need", requestedNeed);
    }
    else url.searchParams.delete("need");
    if (state.q) url.searchParams.set("q", state.q);
    else url.searchParams.delete("q");
    if (state.filters.commercial?.has("commercial ok")) url.searchParams.set("commercial", "yes");
    else url.searchParams.delete("commercial");
    url.searchParams.delete("category");
    url.searchParams.delete("hint");
    state.categories.forEach((category) => url.searchParams.append("category", category));
    history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
  }

  function apply() {
    const catFilter = state.categories.size > 0;
    let visible = 0;

    syncCategoryChips();
    syncFilterChips();

    for (const panel of panels) {
      const cat = panel.dataset.category ?? "";
      const catalog = panel.closest("[data-catalog-panels]")?.getAttribute("data-catalog-panels") ?? "";
      const catalogOn = catalog === state.catalog;
      const panelOn = catalogOn && (!catFilter || state.categories.has(cat));

      let panelVisible = 0;
      const panelRows = rows.filter((r) => r.dataset.category === cat && r.dataset.catalog === catalog);
      for (const row of panelRows) {
        let ok = panelOn;
        if (ok) {
          for (const [key, set] of Object.entries(state.filters)) {
            if (!set.size) continue;
            const vals = (row.dataset[`f${key}`] ?? "").split(",").map((v) => v.trim());
            if (![...set].some((w) => vals.includes(w.toLowerCase()))) {
              ok = false;
              break;
            }
          }
        }
        if (ok && state.q) {
          const hay = row.dataset.haystack ?? "";
          if (!hay.includes(state.q)) ok = false;
        }
        row.classList.toggle("is-hidden", !ok);
        if (ok) {
          visible++;
          panelVisible++;
        }
      }
      const showPanel = panelOn && panelVisible > 0;
      panel.classList.toggle("is-hidden", !showPanel);
      panel.hidden = !showPanel;
      const c = panel.querySelector(".cat-count");
      if (c) c.textContent = String(panelVisible);
    }

    for (const cp of catalogPanels) {
      const on = cp.getAttribute("data-catalog-panels") === state.catalog;
      cp.classList.toggle("is-hidden", !on);
      cp.hidden = !on;
    }

    if (countEl) countEl.textContent = requestedPreset
      ? `${visible} matching entr${visible === 1 ? "y" : "ies"}`
      : `${visible} entr${visible === 1 ? "y" : "ies"}`;
    emptyEl?.classList.toggle("hidden", visible !== 0);
    activeMark?.classList.toggle("hidden", !filtersDirty());
    commercialNote?.classList.toggle("hidden", !state.filters.commercial?.has("commercial ok"));
    updateActiveConstraints();
    syncUrl();
  }

  function switchCatalog(id: string) {
    if (state.catalog === id) return;
    state.catalog = id;
    state.categories.clear();
    state.filters = {};
    state.q = "";
    if (qInput) qInput.value = "";
    catalogTabs.forEach((tab) => {
      const on = tab.dataset.catalogTab === id;
      tab.classList.toggle("is-active", on);
      tab.setAttribute("aria-pressed", on ? "true" : "false");
    });
    rebuildFiltersUI();
    apply();
    syncUrl();
  }

  function setPopover(open: boolean) {
    popover?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
  }

  catalogTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.catalogTab ?? "";
      switchCatalog(id);
    });
  });

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    setPopover(!popover?.classList.contains("is-open"));
  });

  document.addEventListener("click", (e) => {
    if (!popover?.classList.contains("is-open")) return;
    const t = e.target as Node;
    if (popover.contains(t) || toggle?.contains(t)) return;
    setPopover(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (!popover?.classList.contains("is-open")) return;
    setPopover(false);
  });

  document.getElementById("categories-clear")?.addEventListener("click", () => {
    state.categories.clear();
    state.filters = {};
    syncCategoryChips();
    syncFilterChips();
    apply();
  });

  qInput?.addEventListener("input", () => {
    state.q = qInput.value.trim().toLowerCase();
    apply();
  });

  const shareButton = document.getElementById("share-decision");
  const shareMessage = document.getElementById("share-message");
  shareButton?.addEventListener("click", async () => {
    syncUrl();
    const shareUrl = new URL(window.location.href);
    shareUrl.hash = "directory";
    try {
      await navigator.clipboard.writeText(shareUrl.href);
      if (shareMessage) {
        shareMessage.textContent = "Result link copied.";
        shareMessage.classList.remove("hidden");
      }
    } catch {
      if (shareMessage) {
        shareMessage.textContent = "Copy failed. Use the address bar to share this result.";
        shareMessage.classList.remove("hidden");
      }
    }
  });

  bindChips();
  if (requestedPreset && state.catalog !== document.querySelector("[data-catalog-tab].is-active")?.dataset.catalogTab) {
    catalogTabs.forEach((tab) => {
      const on = tab.dataset.catalogTab === state.catalog;
      tab.classList.toggle("is-active", on);
      tab.setAttribute("aria-pressed", on ? "true" : "false");
    });
    rebuildFiltersUI();
  }
  if (qInput) qInput.value = state.q;
  apply();
</script>
