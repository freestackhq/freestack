---
import { CATEGORIES, tools, type Tool } from "../data/tools";

const costLabel: Record<Tool["cost"], string> = {
  free: "free forever",
  credits: "credits",
  student_free: "student free",
  discount: "discount",
};

const whoLabel: Record<Tool["student"], string> = {
  no: "anyone",
  required: "student",
  helps: "student helps",
};

const commercialLabel: Record<Tool["commercial"], string> = {
  yes: "commercial ok",
  hobby: "hobby only",
  edu: "edu only",
  check: "check ToS",
};

// /?hint=ai or /?hint=startup deep-links from guides → pre-select that category filter
const hint = Astro.url.searchParams.get("hint");
const hintCategory =
  hint && CATEGORIES.some((c) => c.id === hint) ? hint : null;
---

<section id="directory" class="pb-24">
  <div
    id="filters"
    class="sticky top-[var(--nav-h)] z-40 border-b border-b1 bg-[#0d0c0bf2] py-3 backdrop-blur-md supports-[backdrop-filter]:bg-[#0d0c0be8]"
  >
    <div class="ds-wrap">
      <div class="flex flex-col gap-3">
        <div class="relative flex min-w-0 items-center gap-2">
          <label class="relative block min-w-0 flex-1">
            <span class="sr-only">Search tools</span>
            <input
              id="q"
              type="search"
              placeholder="Search tools…"
              class="ds-input"
            />
          </label>

          <button
            type="button"
            id="filters-toggle"
            class="ds-chip shrink-0"
            aria-expanded="false"
            aria-controls="filters-popover"
            title="Open filters"
          >
            filters
            <span id="filters-active-mark" class="hidden text-sand">·</span>
          </button>

          <div
            id="filters-popover"
            class="filter-popover absolute top-[calc(100%+8px)] right-0 left-0 z-50 sm:left-auto sm:w-[22rem] rounded-[var(--radius)] border border-b2 bg-s2 p-4 shadow-[0_12px_40px_rgba(0,0,0,0.45)]"
            role="group"
            aria-label="Directory filters"
          >
            <div class="mb-3 flex items-center justify-between gap-3">
              <p class="font-mono text-[0.68rem] tracking-wide text-ink-3 uppercase">
                Categories
              </p>
              <button
                type="button"
                id="categories-clear"
                class="font-mono text-[0.68rem] text-ink-3 underline-offset-2 hover:text-ink-2 hover:underline"
              >
                show all
              </button>
            </div>
            <div
              class="ds-switch max-h-40 overflow-y-auto"
              data-category-group
              role="group"
              aria-label="Categories"
            >
              {
                CATEGORIES.map((cat) => (
                  <button
                    type="button"
                    class:list={[
                      "ds-chip",
                      hintCategory === cat.id && "is-active",
                    ]}
                    data-category={cat.id}
                    aria-pressed={hintCategory === cat.id ? "true" : "false"}
                  >
                    {cat.label}
                  </button>
                ))
              }
            </div>

            <p
              class="mt-4 mb-2 font-mono text-[0.68rem] tracking-wide text-ink-3 uppercase"
            >
              Cost
            </p>
            <div class="ds-switch" data-filter-group="cost" role="radiogroup" aria-label="Cost">
              <button type="button" role="radio" aria-checked="true" data-value="all" class="ds-chip is-active"
                >all</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="free" class="ds-chip"
                >free</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="credits" class="ds-chip"
                >credits</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="student_free" class="ds-chip"
                >student free</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="discount" class="ds-chip"
                >discount</button
              >
            </div>

            <p
              class="mt-4 mb-2 font-mono text-[0.68rem] tracking-wide text-ink-3 uppercase"
            >
              Eligibility
            </p>
            <div
              class="ds-switch"
              data-filter-group="student"
              role="radiogroup"
              aria-label="Eligibility"
            >
              <button type="button" role="radio" aria-checked="true" data-value="all" class="ds-chip is-active"
                >all</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="no" class="ds-chip"
                >anyone</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="required" class="ds-chip"
                >student required</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="helps" class="ds-chip"
                >student helps</button
              >
            </div>

            <p
              class="mt-4 mb-2 font-mono text-[0.68rem] tracking-wide text-ink-3 uppercase"
            >
              Commercial
            </p>
            <div
              class="ds-switch"
              data-filter-group="commercial"
              role="radiogroup"
              aria-label="Commercial use"
            >
              <button type="button" role="radio" aria-checked="true" data-value="all" class="ds-chip is-active"
                >all</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="yes" class="ds-chip"
                >commercial ok</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="hobby" class="ds-chip"
                >hobby only</button
              >
              <button type="button" role="radio" aria-checked="false" data-value="edu" class="ds-chip"
                >edu only</button
              >
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <div
            class="ds-switch"
            data-preset-group
            role="group"
            aria-label="Presets"
          >
            <button
              type="button"
              class="ds-chip"
              data-preset="student"
              aria-pressed="false"
              title="Student unlocks path">student</button
            >
            <button
              type="button"
              class="ds-chip"
              data-preset="startup"
              aria-pressed="false"
              title="Commercial OK + free forever">startup</button
            >
            <button
              type="button"
              class="ds-chip"
              data-preset="hobby"
              aria-pressed="false"
              title="Hobby-only free tiers">hobby</button
            >
          </div>

          <p id="count" class="font-mono text-[0.72rem] text-ink-3">
            {tools.length} tools
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="ds-wrap">
    <div id="empty" class="mt-16 hidden text-center">
      <p class="text-ink-2">Nothing matches. Loosen a filter.</p>
    </div>

    {
      CATEGORIES.map((cat) => {
        const items = tools.filter((t) => t.category === cat.id);
        if (!items.length) return null;
        const startHidden = Boolean(hintCategory) && cat.id !== hintCategory;
        return (
          <section
            class:list={["cat-panel mt-12", startHidden && "is-hidden"]}
            data-category={cat.id}
            hidden={startHidden}
          >
            <div class="ds-section-label !mb-6">
              <span class="ds-section-num">{cat.num}</span>
              <span class="ds-section-name">{cat.label}</span>
              <span class="ds-hairline flex-1" />
              <span class="font-mono text-[0.72rem] text-ink-3 cat-count">{items.length}</span>
            </div>
            <ul class="divide-y divide-b1 border-y border-b1" role="list">
              {items.map((t) => (
                <li
                  class="ds-tool-row tool-row group"
                  data-name={t.name.toLowerCase()}
                  data-blurb={t.blurb.toLowerCase()}
                  data-limits={t.limits.toLowerCase()}
                  data-tags={(t.tags ?? []).join(" ").toLowerCase()}
                  data-cost={t.cost}
                  data-student={t.student}
                  data-commercial={t.commercial}
                  data-category={t.category}
                >
                  <a href={t.url} target="_blank" rel="noopener noreferrer">
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                        <span class="ds-tool-name">{t.name}</span>
                        <span class="font-mono text-[0.68rem] text-ink-3">↗</span>
                      </div>
                      <p class="mt-1 text-[0.92rem] leading-relaxed text-ink-2">{t.blurb}</p>
                    </div>
                    <div class="font-mono text-[0.72rem] leading-relaxed text-ink-2">
                      <span class="text-ink-3">limits · </span>
                      {t.limits}
                      {t.verified && (
                        <>
                          <br />
                          <span class="text-ink-3">verified · {t.verified}</span>
                        </>
                      )}
                    </div>
                    <div class="flex flex-wrap gap-1.5 sm:justify-end">
                      <span class="ds-badge">{costLabel[t.cost]}</span>
                      <span class="ds-badge">{whoLabel[t.student]}</span>
                      <span class="ds-badge">{commercialLabel[t.commercial]}</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</section>

<style>
  .tool-row.is-hidden {
    display: none;
  }
  .cat-panel.is-hidden,
  .cat-panel[hidden] {
    display: none;
  }
  .filter-popover:not(.is-open) {
    display: none;
  }
  .filter-popover.is-open {
    display: block;
  }
</style>

<script>
  const state = {
    categories: new Set<string>(
      (() => {
        const active = document.querySelector<HTMLElement>(
          "[data-category-group] .ds-chip.is-active",
        );
        return active?.dataset.category ? [active.dataset.category] : [];
      })(),
    ),
    q: "",
    cost: "all",
    student: "all",
    commercial: "all",
    preset: null as null | "student" | "startup" | "hobby",
  };

  const rows = [...document.querySelectorAll<HTMLElement>(".tool-row")];
  const panels = [...document.querySelectorAll<HTMLElement>(".cat-panel")];
  const countEl = document.getElementById("count");
  const emptyEl = document.getElementById("empty");
  const qInput = document.getElementById("q") as HTMLInputElement | null;
  const popover = document.getElementById("filters-popover");
  const toggle = document.getElementById("filters-toggle");
  const activeMark = document.getElementById("filters-active-mark");
  const categoryChips = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-category-group] .ds-chip"),
  ];
  const presetChips = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-preset-group] .ds-chip"),
  ];

  function setGroup(key: "cost" | "student" | "commercial", value: string) {
    const group = document.querySelector<HTMLElement>(`[data-filter-group="${key}"]`);
    if (!group) return;
    group.querySelectorAll<HTMLButtonElement>(".ds-chip").forEach((c) => {
      const on = c.dataset.value === value;
      c.classList.toggle("is-active", on);
      c.setAttribute("aria-checked", on ? "true" : "false");
    });
    state[key] = value;
  }

  function syncCategoryChips() {
    categoryChips.forEach((chip) => {
      const id = chip.dataset.category ?? "";
      const on = state.categories.has(id);
      chip.classList.toggle("is-active", on);
      chip.setAttribute("aria-pressed", on ? "true" : "false");
    });
  }

  function syncPresetChips() {
    presetChips.forEach((chip) => {
      const on = chip.dataset.preset === state.preset;
      chip.classList.toggle("is-active", on);
      chip.setAttribute("aria-pressed", on ? "true" : "false");
    });
  }

  function filtersDirty() {
    return (
      state.categories.size > 0 ||
      state.cost !== "all" ||
      state.student !== "all" ||
      state.commercial !== "all"
    );
  }

  function apply() {
    const catFilter = state.categories.size > 0;
    let visible = 0;

    for (const panel of panels) {
      const cat = panel.dataset.category ?? "";
      const panelOn = !catFilter || state.categories.has(cat);
      panel.classList.toggle("is-hidden", !panelOn);
      panel.hidden = !panelOn;

      let panelVisible = 0;
      const panelRows = rows.filter((r) => r.dataset.category === cat);
      for (const row of panelRows) {
        const okCost = state.cost === "all" || row.dataset.cost === state.cost;
        const okStudent =
          state.student === "all" || row.dataset.student === state.student;
        const okCommercial =
          state.commercial === "all" ||
          row.dataset.commercial === state.commercial;
        const hay = `${row.dataset.name} ${row.dataset.blurb} ${row.dataset.limits} ${row.dataset.tags}`;
        const okQ = !state.q || hay.includes(state.q);
        const show = panelOn && okCost && okStudent && okCommercial && okQ;
        row.classList.toggle("is-hidden", !show);
        if (show) {
          visible++;
          panelVisible++;
        }
      }
      const c = panel.querySelector(".cat-count");
      if (c) c.textContent = String(panelVisible);
    }

    if (countEl) countEl.textContent = `${visible} tool${visible === 1 ? "" : "s"}`;
    emptyEl?.classList.toggle("hidden", visible !== 0);
    activeMark?.classList.toggle("hidden", !filtersDirty());
  }

  function applyPreset(name: "student" | "startup" | "hobby" | null) {
    if (state.preset === name || name === null) {
      state.preset = null;
      state.categories.clear();
      setGroup("cost", "all");
      setGroup("student", "all");
      setGroup("commercial", "all");
    } else {
      state.preset = name;
      state.categories.clear();
      if (name === "student") {
        state.categories.add("student");
        setGroup("cost", "all");
        setGroup("student", "required");
        setGroup("commercial", "all");
      } else if (name === "startup") {
        setGroup("cost", "free");
        setGroup("student", "all");
        setGroup("commercial", "yes");
      } else if (name === "hobby") {
        setGroup("cost", "free");
        setGroup("student", "all");
        setGroup("commercial", "hobby");
      }
    }
    syncCategoryChips();
    syncPresetChips();
    apply();
  }

  function setPopover(open: boolean) {
    popover?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
  }

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    setPopover(!popover?.classList.contains("is-open"));
  });

  document.addEventListener("click", (e) => {
    if (!popover?.classList.contains("is-open")) return;
    const t = e.target as Node;
    if (popover.contains(t) || toggle?.contains(t)) return;
    setPopover(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (!popover?.classList.contains("is-open")) return;
    setPopover(false);
  });

  categoryChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const id = chip.dataset.category;
      if (!id) return;
      if (state.categories.has(id)) state.categories.delete(id);
      else state.categories.add(id);
      state.preset = null;
      syncCategoryChips();
      syncPresetChips();
      apply();
    });
  });

  document.getElementById("categories-clear")?.addEventListener("click", () => {
    state.categories.clear();
    state.preset = null;
    syncCategoryChips();
    syncPresetChips();
    apply();
  });

  presetChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const name = chip.dataset.preset as "student" | "startup" | "hobby" | undefined;
      if (!name) return;
      applyPreset(name);
    });
  });

  qInput?.addEventListener("input", () => {
    state.q = qInput.value.trim().toLowerCase();
    apply();
  });

  document.querySelectorAll<HTMLElement>("[data-filter-group]").forEach((group) => {
    const key = group.dataset.filterGroup as "cost" | "student" | "commercial";
    group.querySelectorAll<HTMLButtonElement>(".ds-chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        group.querySelectorAll(".ds-chip").forEach((c) => {
          c.classList.remove("is-active");
          c.setAttribute("aria-checked", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-checked", "true");
        state[key] = btn.dataset.value ?? "all";
        state.preset = null;
        syncPresetChips();
        apply();
      });
    });
  });

  apply();
</script>
