---
/** Contact. No email on purpose: every request is a public GitHub issue. */
import TextPage from "../layouts/TextPage.astro";
import { newIssueUrl } from "../lib/site";
---

<TextPage
  title="Contact"
  description="Reach freestack on GitHub: wrong labels, missing tools, bugs and privacy requests."
  lede="There's no email. Everything goes through GitHub, in public."
>
  <ul>
    <li>Wrong label: open it and choose "Check it".</li>
    <li>
      Missing tool: <a href="/add">Add a tool</a>.
    </li>
    <li>
      Bug, broken link or vendor fix: <a href={newIssueUrl()}>Open an issue</a>.
    </li>
    <li>
      Removing your username: <a href={newIssueUrl("Privacy request: ")}>Open a privacy request</a>.
    </li>
  </ul>
</TextPage>
