---
/**
 * Home (Home.dc.html, PhoneHome.dc.html).
 *
 * Every situation's stack panel is rendered on the server; a small script
 * reads ?as= on load and shows the matching one, so the choice stays in the
 * URL. Presets come from catalog.preset().
 *
 * Server-rendered (not prerendered) so old links (/?hint=<category>,
 * /?catalog=<id>) can answer with a real 301. Static assets are served before
 * the Worker, so a prerendered page could never see its query string.
 */
import Shell from "../layouts/Shell.astro";
import Facts from "../components/fresh/Facts.astro";
import Icon from "../components/fresh/Icon.astro";
import Label from "../components/fresh/Label.astro";
import CopyStack from "../components/fresh/CopyStack.astro";
import {
  aisle as getAisle,
  aisleCount,
  aislesByGroup,
  checkHref,
  defaultSituation,
  isSituation,
  now,
  partForJob,
  parts,
  preset,
  presetIsValid,
  situations,
  toolHref,
  tools,
  toolsInAisle,
  totalTools,
} from "../lib/fresh/catalog";
import { legacyHomeRedirect } from "../lib/catalog";
import { labelState, strings } from "../lib/fresh/label";
import { cardNote, headlineText, limitsLine, stackSearch, type CopyStackData } from "../lib/fresh/stack";

export const prerender = false;

const moved = legacyHomeRedirect(Astro.url.searchParams);
if (moved) return Astro.redirect(moved, 301);

const at = now();
const total = totalTools();
const groups = aislesByGroup().filter((g) => g.aisles.length > 0);

// The situation is read on the server too, so ?as= works without JavaScript.
const asked = Astro.url.searchParams.get("as");
const current = isSituation(asked) ? asked : defaultSituation;

// How many labels someone checked against the vendor's page lately.
const labeled = tools().filter((t) => t.source !== "imported");
const checkedCount = labeled.filter((t) => labelState(t, at) === "checked").length;

const panels = situations().map((s) => {
  const entries = preset(s.id);
  const rows = entries.map((r) => {
    const a = getAisle(r.t.aisle)!;
    const st = strings(r.t, at);
    return {
      job: r.job,
      t: r.t,
      part: partForJob(r.job),
      headline: headlineText(r.t, a),
      limits: limitsLine(r.t, a),
      state: st,
      checked: st.state === "checked",
    };
  });
  const checked = rows.filter((r) => r.checked).length;
  const ready = presetIsValid(entries, at);
  const picks = Object.fromEntries(rows.filter((r) => r.part).map((r) => [r.part!.key, r.t.id]));
  const buildHref = `/build${stackSearch(s.id, picks, parts())}`;
  const copy: Omit<CopyStackData, "url"> & { path: string } = {
    situation: s.label,
    path: buildHref,
    rows: rows.map((r) => ({
      job: r.job,
      name: r.t.name,
      limits: r.limits,
      catch: r.t.catches[0] ?? null,
      checked: r.checked,
    })),
  };
  // No stack: the Claim Once aisles this situation should look at, then the core parts.
  const claim = (s.claim ?? []).map((id) => getAisle(id)).filter((a) => a !== undefined);
  const core = parts()
    .filter((p) => p.core)
    .map((p) => ({ p, a: getAisle(p.aisle)! }));
  return { s, rows, checked, ready, buildHref, copy, note: cardNote(rows.map((r) => r.t)), claim, core };
});
const announce = (p: (typeof panels)[number]) =>
  p.rows.length
    ? `${p.s.label}: ${p.rows.length} parts, ${p.checked} checked.`
    : `${p.s.label}: no ready-made stack yet.`;

// The sample label: a checked one if there is one, else the fullest.
const dbTools = toolsInAisle("databases", at);
const sample =
  dbTools.find((t) => labelState(t, at) === "checked") ??
  [...dbTools].sort(
    (a, b) => Number(b.metric !== null) - Number(a.metric !== null) || b.limits.length - a.limits.length,
  )[0];
---

<Shell title="freestack: pick a free stack">
  <div class="wrap">
    <section class="hero" aria-labelledby="hero-h">
      <div class="intro">
        <h1 id="hero-h">Pick a stack and start building.</h1>
        <p class="lede">{total} free tools, student perks and APIs. Limits and catches up front.</p>
        <p class="trust">
          <Icon name="check" size={18} />
          <span>
            {checkedCount} of {labeled.length} labels checked against the vendor's page in the last 90 days.{" "}
            <a href="#label-h">How to read a label</a>
          </span>
        </p>
      </div>

      <section class="basket panel-raised" aria-labelledby="basket-h" data-home-stack>
        <div class="picker">
          <h2 id="basket-h">I'm building as</h2>
          <div class="chips" role="group" aria-labelledby="basket-h">
            {situations().map((s) => (
              <button type="button" class="chip" data-sit={s.id} aria-pressed={s.id === current ? "true" : "false"}>
                {s.label}
              </button>
            ))}
          </div>
        </div>
        <p class="sr-only" role="status" data-announce>
          {announce(panels.find((p) => p.s.id === current)!)}
        </p>

        {panels.map((p) => (
          <div class="stack" data-panel={p.s.id} data-announce-text={announce(p)} hidden={p.s.id !== current}>
            {p.s.note && <p class="sit-note">{p.s.note}</p>}
            {p.rows.length > 0 ? (
              <>
                <p class="stack-head">
                  <strong>{p.ready ? "Ready-made stack" : "Starter stack"}</strong>
                  <span>
                    {p.ready
                      ? "Every part checked against the vendor's page."
                      : `${p.checked} of ${p.rows.length} parts checked. The rest are from the catalog, not checked yet.`}
                  </span>
                </p>
                <ul class="rows" aria-label={`Stack for ${p.s.label}`}>
                  {p.rows.map((r) => (
                    <li class="row" data-tool={r.t.id}>
                      <span class="job">{r.job}</span>
                      <span class="body">
                        <span class="line">
                          <a class="tool" href={toolHref(r.t)}>
                            {r.t.name}
                          </a>
                          <span class="headline">{r.headline}</span>
                        </span>
                        {r.t.catches[0] && (
                          <span class="catch">
                            <Icon name="wrench" />
                            <span class="sr-only">Catch: </span>
                            {r.t.catches[0]}
                          </span>
                        )}
                        <span class="meta">
                          <Facts tool={r.t} hideWho class="facts" />
                          <span class="state" data-state={r.state.state}>
                            {r.checked && <Icon name="check" size={16} />}
                            <span>{r.state.text}</span>
                            {r.state.link && (
                              <a href={checkHref(r.t)}>
                                {r.state.link}
                                <span class="sr-only"> {r.t.name}</span>
                              </a>
                            )}
                          </span>
                        </span>
                      </span>
                    </li>
                  ))}
                </ul>
                <div class="total">
                  <div>
                    <p class="total-label">Total per month</p>
                    {p.note && <p class="total-note">{p.note}</p>}
                  </div>
                  <p class="price">$0.00</p>
                </div>
                <div class="actions">
                  <button type="button" class="btn btn-promo copy-btn" data-copy-stack={JSON.stringify(p.copy)}>
                    Copy this stack
                  </button>
                  <button type="button" class="link-btn" data-copy-stack={JSON.stringify(p.copy)} data-format="agent">
                    Hand it to my coding agent
                  </button>
                  <a class="link-btn" href={p.buildHref}>
                    Swap parts in Build a stack
                  </a>
                </div>
              </>
            ) : (
              <div class="empty" data-empty>
                <p class="empty-title">No ready-made stack here yet.</p>
                {p.claim.length > 0 && (
                  <>
                    <h3 class="empty-h">Claim these first</h3>
                    <ul class="pick-list">
                      {p.claim.map((a) => (
                        <li>
                          <a href={`/${a.id}`}>
                            <span>{a.name}</span>
                            <span class="count">{aisleCount(a.id)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                <h3 class="empty-h">Then pick each part</h3>
                <ul class="pick-list">
                  {p.core.map(({ p: part, a }) => (
                    <li>
                      <a href={`/${a.id}`}>
                        <span>
                          {part.label}
                          <span class="via"> in {a.name}</span>
                        </span>
                        <span class="count">{aisleCount(a.id)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="btn btn-promo empty-cta" href={p.buildHref}>
                  Start one in Build a stack
                </a>
              </div>
            )}
          </div>
        ))}
      </section>
    </section>

    <section class="aisles" aria-labelledby="aisles-h">
      <h2 id="aisles-h" class="h2">
        Or walk the aisles
      </h2>
      <p class="sub">Grouped by what you need. Numbers show how many tools have a label.</p>
      <div class="groups">
        {groups.map((g) => (
          <div>
            <h3 class="group">{g.group}</h3>
            <ul class="aisle-list">
              {g.aisles.map((a) => (
                <li>
                  <a href={`/${a.id}`}>
                    {a.name} <span class="count">{aisleCount(a.id)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {sample && (
      <section class="reading" aria-labelledby="label-h">
        <div class="reading-text">
          <h2 id="label-h" class="h2">
            Reading a label
          </h2>
          <ol>
            <li>
              <strong>The big number</strong> is the one limit that aisle is about, like storage for databases. The
              5-step scale beside it compares it with the biggest in the aisle.
            </li>
            <li>
              <strong>The fine print</strong> lists the exact limits.
            </li>
            <li>
              <strong>The bottom line</strong> covers who can claim it, whether you can sell with it, and whether signup
              needs a credit card. A check means yes, a cross means no, and a dashed icon means nobody knows yet. The
              card shows crossed out when you can sign up without one.
            </li>
            <li>
              <strong>The date</strong> is when someone last checked the vendor's page. No date means nobody has.
            </li>
          </ol>
        </div>
        <figure>
          <Label tool={sample} compare={false} />
          <figcaption>
            Limits as listed in the catalog. Always confirm on the vendor's page before you launch.
          </figcaption>
        </figure>
      </section>
    )}

    <section id="agents" class="agents on-ink" aria-labelledby="agents-h">
      <div>
        <h2 id="agents-h">Let your coding agent shop for you</h2>
        <p>
          Install the freestack skill and your agent checks these labels before it reaches for anything paid. It tells
          you the limits it found.
        </p>
      </div>
      <div class="agents-cmd">
        <code>npx skills add https://github.com/freestackhq/freestack</code>
        <p>
          Also available as a remote MCP server and a plain JSON API. <a href="/agents">Set it up</a>
        </p>
      </div>
    </section>
  </div>

  <CopyStack slot="end" />
</Shell>

<script>
  import { openCopyStack, type CopyFormat } from "../lib/fresh/copy-stack";

  const root = document.querySelector<HTMLElement>("[data-home-stack]")!;
  const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-sit]")];
  const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
  const announcer = root.querySelector<HTMLElement>("[data-announce]")!;
  const ids = panels.map((p) => p.dataset.panel!);
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Switch the visible stack, say what changed, and mark rows that are new to it.
  function pick(id: string, fromUser: boolean) {
    if (!ids.includes(id)) return;
    const before = panels.find((p) => !p.hidden);
    const was = new Set([...(before?.querySelectorAll<HTMLElement>("[data-tool]") ?? [])].map((r) => r.dataset.tool));
    for (const c of chips) c.setAttribute("aria-pressed", String(c.dataset.sit === id));
    for (const p of panels) p.hidden = p.dataset.panel !== id;
    if (!fromUser) return;
    const now = panels.find((p) => p.dataset.panel === id)!;
    announcer.textContent = now.dataset.announceText ?? "";
    if (before && before !== now && !reduceMotion) {
      for (const r of now.querySelectorAll<HTMLElement>("[data-tool]")) {
        if (was.has(r.dataset.tool)) continue;
        r.classList.remove("is-new");
        void r.offsetWidth; // restart the animation
        r.classList.add("is-new");
      }
    }
    const url = new URL(location.href);
    url.searchParams.set("as", id);
    history.replaceState(null, "", url);
  }

  for (const c of chips) c.addEventListener("click", () => pick(c.dataset.sit!, true));

  root.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-copy-stack]");
    if (!btn) return;
    const { path, ...rest } = JSON.parse(btn.dataset.copyStack!);
    const format = (btn.dataset.format as CopyFormat | undefined) ?? "md";
    openCopyStack({ ...rest, url: new URL(path, location.origin).href }, format, btn);
  });
</script>

<style>
