    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }
  .intro {
    flex: 1 1 400px;
    min-width: 0;
    padding-top: 24px;
  }
  /* Three lines at most beside the panel, so the total stays near the fold. */
  h1 {
    margin: 0;
    font-weight: 900;
    font-stretch: 62%;
    font-size: clamp(48px, 6.4vw, 92px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .lede {
    margin: 24px 0 0;
    max-width: 34ch;
    font-size: 20px;
    font-weight: 500;
  }
  .trust {
    margin: 20px 0 0;
    max-width: 40ch;
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 15px;
    color: var(--muted);
  }
  .trust :global(svg) {
    flex: none;
    align-self: center;
    color: var(--ink);
  }
  .trust a {
    font-weight: 700;
  }

  .basket {
    flex: 1 1 600px;
    min-width: 0;
  }
  .picker {
    padding: 24px 28px 20px;
    border-bottom: 2px solid var(--ink);
  }
  .picker h2 {
    margin: 0 0 14px;
    font-size: 18px;
    font-weight: 700;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sit-note {
    margin: 0;
    padding: 14px 28px 0;
    font-size: 15px;
    font-weight: 600;
  }
  .stack-head {
    margin: 0;
    padding: 6px 28px 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    align-items: baseline;
    font-size: 14px;
    color: var(--muted);
  }
  .stack-head strong {
    color: var(--ink);
    font-size: 15px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0 28px;
  }
  .row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 4px 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px dashed var(--rule);
  }
  /* A row that is new to this situation fades from the fill color once. */
  .row.is-new {
    animation: row-new 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes row-new {
    from {
      background: var(--fill);
    }
  }
  .job {
    font-size: 14px;
    color: var(--muted);
  }
  .body {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
  }
  .tool {
    min-width: var(--target);
    /* 44px tap target without moving the row */
    padding-block: 10px;
    margin-block: -10px;
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
  }
  .tool:hover {
    text-decoration: underline;
  }
  /* The headline limit speaks in the label's condensed voice. */
  .headline {
    font-weight: 900;
    font-stretch: 62%;
    font-size: 22px;
    line-height: 1.1;
    /* Condensed spaces nearly vanish; give the words room. */
    word-spacing: 0.18em;
    text-align: right;
  }
  .catch {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 16px;
    font-size: 14px;
  }
  .meta :global(.facts) {
