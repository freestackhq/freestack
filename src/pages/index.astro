---
import Layout from "../layouts/Layout.astro";
import AudiencePaths from "../components/AudiencePaths.astro";
---

<Layout>
  <section class="ds-wrap pb-12 pt-[72px] sm:pb-16 sm:pt-[104px]">
    <h1 class="max-w-4xl text-[clamp(3.2rem,9vw,6rem)] leading-[0.9] font-bold tracking-[-0.04em] text-ink">
      Choose the right free tool<span class="text-sand">.</span>
    </h1>
    <p class="mt-7 max-w-2xl text-[clamp(1rem,1.5vw,1.12rem)] leading-[1.75] text-ink-2">
      Find tools for your project and check their limits, eligibility, and terms before you commit.
    </p>
    <a href="/catalogs" class="ds-btn ds-btn-outline mt-5">Browse tools <span aria-hidden="true">→</span></a>

    <div id="paths" class="mt-12 scroll-mt-[calc(var(--nav-h)+1rem)] border-t border-b1 pt-7 sm:mt-16">
      <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink">What are you trying to do?</h2>
      <p class="mt-2 max-w-xl text-sm leading-6 text-ink-2">Choose a path for practical guidance and relevant tools.</p>
      <AudiencePaths />
    </div>
  </section>

</Layout>
