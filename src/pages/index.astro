---
import Layout from "../layouts/Layout.astro";
import Directory from "../components/Directory.astro";
---

<Layout>
  <section class="ds-wrap pb-16 pt-[88px] sm:pt-[120px]">
    <h1
      class="mb-7 text-[clamp(3.2rem,9vw,7.5rem)] leading-[0.9] font-bold tracking-[-0.045em] text-ink"
    >
      freestack<span class="text-ink-3">.</span>
    </h1>

    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
      <p class="max-w-xl text-[clamp(0.9rem,1.5vw,1.05rem)] leading-[1.75] text-ink-2">
        Free developer tools, student unlocks, and self-hosted software.
        Each listing states the{" "}
        <strong class="font-medium text-ink">hard limits</strong>, who can claim it, and
        whether commercial use is allowed — for builders tired of “generous free tier”
        without numbers.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/guides/claim-order" class="ds-btn ds-btn-filled">Claim order →</a>
        <a
          href="https://github.com/freestackhq/saas"
          target="_blank"
          rel="noopener noreferrer"
          class="ds-btn ds-btn-outline">catalog repo ↗</a
        >
      </div>
    </div>
  </section>

  <Directory defaultCatalog="saas" />
</Layout>
