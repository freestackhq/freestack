---
/**
 * Add a tool: sent (AddToolSent.dc.html). Receives the Add a tool form,
 * hands it to the sendNewTool stub (nothing leaves the server), and shows
 * the pending label. Opening it without a form goes back to /add.
 */
import Shell from "../../layouts/Shell.astro";
import Icon from "../../components/fresh/Icon.astro";
import Label from "../../components/fresh/Label.astro";
import { aisle as getAisle, aisles, tools } from "../../lib/fresh/catalog";
import { readDraft, type DraftErrors } from "../../lib/fresh/addtool";
import { sendNewTool, type SendToolResult } from "../../lib/fresh/send";
import { shortUrl } from "../../lib/fresh/url";

export const prerender = false;

if (Astro.request.method !== "POST") return Astro.redirect("/add", 303);

const { draft, errors } = readDraft(await Astro.request.formData(), aisles(), tools());
const result: SendToolResult | null = draft ? await sendNewTool(draft) : null;
const t = draft?.tool;
const a = t ? getAisle(t.aisle) : undefined;
const missing = Object.values(errors as DraftErrors).filter(Boolean);
---

<Shell title={t ? `Sent: ${t.name} · freestack` : "Add a tool · freestack"} noindex>
  {
    t && a && result ? (
      <div class="wrap page">
        <div role="status" class="main">
          <h1 class="h">Sent. Thanks.</h1>
          <p class="lede">
            Your label for {t.name} is waiting for review. Nothing shows on the site until someone checks it.
          </p>
          <h2 class="next-h">What happens next</h2>
          <ol class="steps">
            <li>
              <span class="n" aria-hidden="true">1</span>
              <span>
                <span class="step">A maintainer compares it with {shortUrl(t.pricing_url)}.</span>
                <span class="muted">Usually within a week.</span>
              </span>
            </li>
            <li>
              <span class="n" aria-hidden="true">2</span>
              <span>
                <span class="step">It goes live in the {a.name} aisle.</span>
                <span class="muted">Marked "Checked" with today's date.</span>
              </span>
            </li>
            <li>
              <span class="n" aria-hidden="true">3</span>
              {draft!.credit ? (
                <span>
                  <span class="step">Your name goes on it.</span>
                  <span class="muted">As the one who added it. You left a name, so it shows.</span>
                </span>
              ) : (
                <span>
                  <span class="step">It stays anonymous.</span>
                  <span class="muted">You left the name empty, so no name shows.</span>
                </span>
              )}
            </li>
          </ol>
          <div class="actions">
            <a class="btn" href="/add">Add another tool</a>
            <a class="btn btn-outline" href={`/${a.id}`}>Back to {a.name}</a>
            {result.placeholder ? (
              <span class="pr">
                <a href={result.prUrl} data-placeholder="true" aria-describedby="pr-note">
                  Follow it on GitHub
                </a>
                <span id="pr-note" class="muted pr-note">Placeholder. Sending is not wired up yet, so there is no pull request.</span>
              </span>
            ) : (
              <a class="pr" href={result.prUrl} target="_blank" rel="noopener">
                Follow it on GitHub<Icon name="external" size={14} />
                <span class="sr-only">, opens in a new tab</span>
              </a>
            )}
          </div>
        </div>
        <div class="preview">
          <p class="cap">How it will look</p>
          <Label tool={t} compare={false} link={false} />
        </div>
      </div>
    ) : (
      <div class="wrap page">
        <div role="alert" class="main">
          <h1 class="h">Some answers are missing</h1>
          <ul class="missing">
            {missing.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
          <div class="actions">
            <a class="btn" href="/add">Back to the form</a>
          </div>
        </div>
      </div>
    )
  }
</Shell>

<style>
  .page {
    padding-block: 56px 96px;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 360px);
    gap: 56px;
    align-items: start;
  }
  .h {
    margin: 0;
    font-weight: 900;
    font-stretch: 62%;
    line-height: 1;
    font-size: clamp(56px, 8.5vw, 120px);
  }
  .lede {
    margin: 16px 0 0;
    max-width: 38ch;
    font-size: 20px;
    line-height: 1.45;
  }
  .next-h {
    margin: 40px 0 0;
    font-size: 19px;
    font-weight: 800;
  }
  .steps {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .n {
    font-weight: 900;
    font-stretch: 62%;
    font-size: 32px;
    line-height: 1;
  }
  .step {
    display: block;
    font-size: 17px;
    font-weight: 700;
  }
  .steps .muted {
    display: block;
    margin-top: 2px;
    font-size: 15px;
  }
  .actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
  }
  .pr {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 8px;
    font-size: 15px;
    font-weight: 700;
  }
  .pr a,
  a.pr {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--target);
  }
  .pr-note {
    font-size: 13px;
    font-weight: 500;
  }
  .cap {
    margin: 0 0 12px;
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
  }
  .missing {
    margin: 20px 0 0;
    padding-left: 20px;
    font-size: 17px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .page {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-block: 32px 64px;
    }
    .lede {
      font-size: 18px;
    }
  }
</style>
