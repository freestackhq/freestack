---
/**
 * API docs: the Scalar reference for /api/openapi.json, inside the fresh shell.
 */
import Shell from "../layouts/Shell.astro";
---

<Shell title="API docs · freestack" description="Interactive reference for the freestack JSON API.">
  <div class="wrap head">
    <p class="crumbs muted">API</p>
    <h1 class="title-md">freestack API</h1>
    <p class="lede">
      Public JSON, CORS open. Spec: <a href="/api/openapi.json">/api/openapi.json</a>. Coding agents can also use the{" "}
      <a href="/agents">MCP server</a>.
    </p>
  </div>

  <div id="scalar-root" class="scalar"></div>

  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.28.11/dist/browser/standalone.js"
    slot="end"></script>
  <script is:inline slot="end">
    window.Scalar.createApiReference("#scalar-root", {
      url: "/api/openapi.json",
      theme: "default",
      darkMode: false,
      hideDarkModeToggle: true,
      layout: "modern",
      defaultHttpClient: { targetKey: "shell", clientKey: "curl" },
    });
  </script>
</Shell>

<style>
  .head {
    padding-block: 40px 24px;
  }
  .lede {
    margin: 12px 0 0;
    max-width: 60ch;
    font-size: 18px;
  }
  .lede a {
    color: var(--ink);
    font-weight: 700;
  }
  .scalar {
    min-height: 75vh;
    background: var(--label);
    border-top: 1px solid var(--rule);
  }
</style>
