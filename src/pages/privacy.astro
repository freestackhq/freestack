---
/**
 * Privacy policy. Says only what the code does. The analytics line follows the
 * build's env, so the page never claims a beacon the site doesn't have.
 */
import TextPage from "../layouts/TextPage.astro";
import { analyticsBeacon } from "../lib/analytics";
import { REPO_URL, newIssueUrl } from "../lib/site";

const GITHUB_PRIVACY = "https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement";
const analyticsOn = analyticsBeacon(import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN) !== null;
---

<TextPage
  title="Privacy"
  description="What freestack collects and who handles it."
  lede="No accounts, no cookies, nothing stored about you."
  updated="2026-11-19"
>
  <h2>Who sees what</h2>
  <ul>
    <li>
      <strong>Cloudflare</strong> serves the site, the API and the MCP server. It sees each request's IP address and
      browser. Workers logs are off, so we keep none.{" "}
      <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare's privacy policy</a>
    </li>
    <li>
      <strong>GitHub</strong> holds every check, new tool and request you send. All of it is public. A "Still true"
      check adds your GitHub username to the label. <a href={GITHUB_PRIVACY}>GitHub's privacy statement</a>
    </li>
    <li data-analytics={analyticsOn ? "on" : "off"}>
      {analyticsOn ? (
        <>Cloudflare Web Analytics counts page views, without cookies or fingerprinting.</>
      ) : (
        <>No analytics.</>
      )}
    </li>
    <li>Fonts load from this site. Search and compare picks stay in your browser.</li>
  </ul>

  <h2>Removing your username</h2>
  <p>
    <a href={newIssueUrl("Privacy request: ")}>Open a privacy request</a> and we'll take it off the data. Older commits
    in the <a href={REPO_URL}>public repository</a> still carry it.
  </p>

  <h2>Who runs freestack</h2>
  <p>A non-commercial, open-source project, run by its maintainers on GitHub.</p>
</TextPage>
