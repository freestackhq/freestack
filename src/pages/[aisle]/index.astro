---
/**
 * Every aisle page. Claim Once aisles (/student-programs, /cloud-credits, ...)
 * use the program layout (Programs.dc.html); the rest use the label grid
 * (Aisle.dc.html).
 */
import AislePage from "../../components/fresh/AislePage.astro";
import ProgramsPage from "../../components/fresh/ProgramsPage.astro";
import { aisles } from "../../lib/fresh/catalog";
import type { Aisle } from "../../lib/fresh/types";

export function getStaticPaths() {
  return aisles().map((a) => ({ params: { aisle: a.id }, props: { aisle: a } }));
}

interface Props {
  aisle: Aisle;
}

const { aisle } = Astro.props;
---

{aisle.group === "Claim Once" ? <ProgramsPage aisle={aisle} /> : <AislePage aisle={aisle} />}
