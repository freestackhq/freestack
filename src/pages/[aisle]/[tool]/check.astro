---
/**
 * Check a label (Verify.dc.html, PhoneVerify.dc.html).
 * One fieldset per line: Still true or Changed (Changed asks for the new value).
 * "Send on GitHub" opens the label-check issue form prefilled with the answers
 * (src/lib/fresh/send.ts); the label-check workflow does the rest. All still
 * true: the label shows "Checked today" once the issue is processed. Any
 * changed: "A change is waiting for review". A link too long for GitHub
 * shows the issue body to copy instead (it replaces the old failed-send edge).
 */
import Shell from "../../../layouts/Shell.astro";
import Icon from "../../../components/fresh/Icon.astro";
import Label from "../../../components/fresh/Label.astro";
import { aisle as getAisle, now, tool as getTool, toolHref, tools } from "../../../lib/fresh/catalog";
import { checkLines, checkSummary } from "../../../lib/fresh/checks";
import { shortUrl } from "../../../lib/fresh/url";
import { GITHUB_REPO } from "../../../lib/site";
import type { Tool } from "../../../lib/fresh/types";

export function getStaticPaths() {
  return tools()
    .filter((t) => t.source !== "imported")
    .map((t) => ({ params: { aisle: t.aisle, tool: t.id } }));
}

const t = getTool(Astro.params.tool!)!;
const a = getAisle(t.aisle)!;
const lines = checkLines(t, a);
const at = now();
const today = at.toISOString().slice(0, 10);

const asChecked: Tool = { ...t, verified_at: today, verified_by: null, review_pending: false, vendor_changed_at: null };
const asReview: Tool = { ...t, review_pending: true };

const pricingText = shortUrl(t.pricing_url);
---

<Shell title={`Check ${t.name}'s label · freestack`} aisle={a.id} noindex>
  <div
    class="wrap page"
    data-check
    data-repo={GITHUB_REPO}
    data-tool={t.id}
    data-name={t.name}
    data-pricing={t.pricing_url}
    data-lines={JSON.stringify(lines)}
  >
    <a class="back" href={toolHref(t)}>
      <Icon name="back" size={16} />
      {t.name}
    </a>

    <div data-view="form">
      <h1 class="h" tabindex="-1">
        Check {t.name}'s label
      </h1>
      <p class="lede">Open {t.name}'s pricing page next to this one. For each line, tell us if it still holds.</p>
      <a class="btn btn-outline open" href={t.pricing_url} target="_blank" rel="noopener">
        Open {pricingText}
        <Icon name="external" size={14} />
        <span class="sr-only">, opens in a new tab</span>
      </a>

      <form class="sheet" data-check-form novalidate>
        {lines.map((l) => (
          <fieldset class="line" data-line={l.id}>
            <legend class="sr-only">
              {l.label}: {l.value}
            </legend>
            <div class="what" aria-hidden="true">
              <p class="lbl">{l.label}</p>
              <p class="val">{l.value}</p>
            </div>
            <div class="choice">
              <button type="button" class="pick" aria-pressed="false" data-verdict="holds">
                Still true
              </button>
              <button type="button" class="pick" aria-pressed="false" data-verdict="changed">
                Changed
              </button>
            </div>
            <div class="now" data-now hidden>
              <label for={`${l.id}-now`}>What does it say now?</label>
              <input
                id={`${l.id}-now`}
                class="field"
                type="text"
                placeholder="Write it the way the page does"
                aria-describedby={`${l.id}-err`}
                autocomplete="off"
              />
              <p class="err" id={`${l.id}-err`} hidden>
                <Icon name="cross" />
                Write what the page says now, or pick Still true.
              </p>
            </div>
          </fieldset>
        ))}

        <div class="foot">
          <div class="credit">
            <label for="check-note">
              Anything else <span class="opt">optional</span>
            </label>
            <textarea id="check-note" class="field" rows="2" aria-describedby="check-note-hint"></textarea>
            <p id="check-note-hint" class="muted hint">
              The label credits your GitHub name as "Checked by".
            </p>
          </div>

          <div class="alert" role="alert" data-alert hidden>
            <p class="alert-h">Too long for a GitHub link</p>
            <p>Copy this, open a new issue, and paste it as the description. Your answers are still here.</p>
            <label class="copy-lbl" for="check-body">
              Issue description
            </label>
            <textarea id="check-body" class="field copy" rows="8" readonly data-copy-body></textarea>
            <div class="copy-row">
              <button type="button" class="btn btn-outline" data-copy>
                Copy
              </button>
              <a class="btn btn-promo" href="#" target="_blank" rel="noopener" data-new-issue>
                Open a new issue
                <Icon name="external" size={14} />
                <span class="sr-only">, opens GitHub in a new tab</span>
              </a>
              <span class="muted hint" role="status" data-copied></span>
            </div>
          </div>
        </div>

        <div class="send-row">
          <button type="submit" class="btn btn-promo" data-send>
            Send on GitHub
          </button>
          <span class="muted summary" data-summary aria-live="polite">
            {checkSummary(0, lines.length)}
          </span>
          <p class="err" data-empty hidden>
            Answer at least one line first.
          </p>
        </div>
      </form>
    </div>

    <div class="done" data-view="done" role="status" hidden>
      <h1 class="h" tabindex="-1" data-done-title></h1>
      <p class="lede" data-done-body></p>
      <div class="preview" data-preview></div>
      <p class="again">
        <a href="#" target="_blank" rel="noopener" data-again>
          GitHub did not open? Open your check on GitHub<span class="sr-only">, opens in a new tab</span>
        </a>
      </p>
      <div class="actions">
        <a class="btn" href={`/${a.id}`}>
          Check another label
        </a>
        <button type="button" class="btn btn-outline" data-reset>
          Back to the form
        </button>
      </div>
    </div>

    <template data-preview-checked>
      <Label tool={asChecked} now={at} variant="mini" compare={false} link={false} level={2} />
    </template>
    <template data-preview-review>
      <Label tool={asReview} now={at} variant="mini" compare={false} link={false} level={2} />
    </template>
  </div>
</Shell>

<style>
  .page {
    padding-block: 40px 96px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--target);
    margin: 0 0 12px -4px;
    padding: 0 14px 0 8px;
    border: 2px solid var(--ink);
    background: var(--label);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }
  .h {
    margin: 0;
    font-weight: 900;
    font-stretch: 62%;
    line-height: 1;
    font-size: clamp(44px, 7vw, 96px);
  }
  .h:focus {
    outline: 0;
  }
  .lede {
    margin: 14px 0 0;
    max-width: 52ch;
    font-size: 18px;
    line-height: 1.45;
  }
  .open {
    margin-top: 20px;
  }
  .sheet {
    margin-top: 32px;
    max-width: 820px;
    background: var(--label);
    border: 2px solid var(--ink);
  }
  .line {
    margin: 0;
    padding: 20px 24px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px 20px;
    align-items: center;
    min-width: 0;
  }
  .lbl {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .val {
    margin: 2px 0 0;
    font-weight: 900;
    font-stretch: 62%;
    font-size: 36px;
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .choice {
    display: flex;
    gap: 6px;
  }
  .pick {
    min-height: var(--target);
    padding: 0 14px;
    border: 2px solid var(--ink);
    background: var(--label);
    color: var(--ink);
    font: 700 15px var(--font);
    cursor: pointer;
  }
  .pick[aria-pressed="true"] {
    background: var(--ink);
    color: var(--label);
  }
  .now {
    grid-column: 1 / -1;
  }
  .now label,
  .credit label,
  .copy-lbl {
    display: block;
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
  }
  .field[aria-invalid="true"] {
    box-shadow: inset 0 0 0 2px var(--recheck);
  }
  .err {
    margin: 8px 0 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
  }
  .foot {
    padding: 20px 24px;
    display: grid;
    gap: 16px;
  }
  .credit {
    max-width: 420px;
  }
  .opt {
    font-weight: 500;
    color: var(--muted);
  }
  textarea.field {
    resize: vertical;
  }
  .copy {
    font-size: 14px;
  }
  .alert .copy-lbl {
    margin: 0;
  }
  .copy-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .hint {
    margin: 6px 0 0;
    font-size: 14px;
  }
  .send-row {
    padding: 0 24px 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .send-row .err {
    flex-basis: 100%;
    margin: 0;
  }
  .summary {
    font-size: 14px;
  }
  .alert {
    padding: 22px 24px;
    display: grid;
    gap: 12px;
    background: var(--label);
    border: 1px solid var(--rule);
    border-top: 8px solid var(--recheck);
  }
  .alert p {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }
  .alert .alert-h {
    font-size: 19px;
    font-weight: 800;
  }

  .done {
    max-width: 820px;
  }
  .preview {
    margin-top: 28px;
    max-width: 360px;
  }
  .again {
    margin: 16px 0 0;
    font-size: 15px;
  }
  .again a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }
  .actions {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 640px) {
    .page {
      padding-block: 4px 0;
    }
    .back {
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      font-weight: 600;
      font-size: 14px;
    }
    .lede {
      font-size: 16px;
    }
    .open {
      display: flex;
      margin-top: 10px;
    }
    .sheet {
      margin-top: 12px;
    }
    .line {
      padding: 12px 14px;
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .what {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }
    .val {
      margin: 0;
      font-size: 28px;
      text-align: right;
    }
    .pick {
      flex: 1;
    }
    .foot {
      padding: 16px 14px;
    }
    .send-row {
      position: sticky;
      bottom: 0;
      z-index: 1;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      background: var(--label);
      border-top: 2px solid var(--ink);
      flex-direction: column;
      align-items: stretch;
    }
    .send-row .summary {
      order: -1;
    }
    .send-row .btn {
      width: 100%;
    }
    .done {
      padding-block: 16px 48px;
    }
  }
</style>

<script>
  import { checkOutcome, checkSummary, type CheckAnswer, type CheckLine } from "../../../lib/fresh/checks";
  import { labelCheckLink, type IssueLink } from "../../../lib/fresh/send";

  const root = document.querySelector<HTMLElement>("[data-check]")!;
  const form = root.querySelector<HTMLFormElement>("[data-check-form]")!;
  const formView = root.querySelector<HTMLElement>('[data-view="form"]')!;
  const doneView = root.querySelector<HTMLElement>('[data-view="done"]')!;
  const lines = Array.from(form.querySelectorAll<HTMLFieldSetElement>("[data-line]"));
  const summary = form.querySelector<HTMLElement>("[data-summary]")!;
  const emptyErr = form.querySelector<HTMLElement>("[data-empty]")!;
  const alertBox = form.querySelector<HTMLElement>("[data-alert]")!;
  const send = form.querySelector<HTMLButtonElement>("[data-send]")!;
  const note = form.querySelector<HTMLTextAreaElement>("#check-note")!;
  const copyBody = form.querySelector<HTMLTextAreaElement>("[data-copy-body]")!;
  const copied = form.querySelector<HTMLElement>("[data-copied]")!;
  const name = root.dataset.name!;
  const checkLines = JSON.parse(root.dataset.lines!) as CheckLine[];
  const tool = { id: root.dataset.tool!, name, pricing_url: root.dataset.pricing! };

  function verdict(fs: HTMLFieldSetElement): CheckAnswer["verdict"] | null {
    const on = fs.querySelector<HTMLButtonElement>('[aria-pressed="true"]');
    return (on?.dataset.verdict as CheckAnswer["verdict"]) ?? null;
  }

  function nowInput(fs: HTMLFieldSetElement) {
    return fs.querySelector<HTMLInputElement>("[data-now] input")!;
  }

  function setLineError(fs: HTMLFieldSetElement, on: boolean) {
    const input = nowInput(fs);
    if (on) input.setAttribute("aria-invalid", "true");
    else input.removeAttribute("aria-invalid");
    fs.querySelector<HTMLElement>(".err")!.hidden = !on;
  }

  // Any edit makes an earlier copy box stale.
  function update() {
    const answered = lines.filter((fs) => verdict(fs)).length;
    summary.textContent = checkSummary(answered, lines.length);
    if (answered > 0) emptyErr.hidden = true;
    showCopy(null);
  }

  lines.forEach((fs) => {
    fs.querySelectorAll<HTMLButtonElement>("[data-verdict]").forEach((b) =>
      b.addEventListener("click", () => {
        fs.querySelectorAll<HTMLButtonElement>("[data-verdict]").forEach((o) =>
          o.setAttribute("aria-pressed", String(o === b)),
        );
        const changed = b.dataset.verdict === "changed";
        fs.querySelector<HTMLElement>("[data-now]")!.hidden = !changed;
        if (changed) nowInput(fs).focus();
        else setLineError(fs, false);
        update();
      }),
    );
    nowInput(fs).addEventListener("input", () => {
      if (nowInput(fs).value.trim()) setLineError(fs, false);
      showCopy(null);
    });
  });
  note.addEventListener("input", () => showCopy(null));

  function answers(): CheckAnswer[] {
    return lines.flatMap((fs) => {
      const v = verdict(fs);
      if (!v) return [];
      return [{ id: fs.dataset.line!, verdict: v, ...(v === "changed" ? { now: nowInput(fs).value.trim() } : {}) }];
    });
  }

  // Too long for a link: the body to paste and a plain new-issue link. One yellow action at a time.
  function showCopy(link: Extract<IssueLink, { kind: "copy" }> | null) {
    alertBox.hidden = !link;
    send.hidden = !!link;
    copied.textContent = "";
    if (!link) return;
    copyBody.value = link.body;
    form.querySelector<HTMLAnchorElement>("[data-new-issue]")!.href = link.url;
  }

  form.querySelector("[data-copy]")!.addEventListener("click", async () => {
    copyBody.select();
    try {
      await navigator.clipboard.writeText(copyBody.value);
      copied.textContent = "Copied";
    } catch {
      copied.textContent = "Select the text and copy it";
    }
  });

  function showDone(kind: "checked" | "review", changed: number, url: string) {
    const title = doneView.querySelector<HTMLElement>("[data-done-title]")!;
    const body = doneView.querySelector<HTMLElement>("[data-done-body]")!;
    const preview = doneView.querySelector<HTMLElement>("[data-preview]")!;
    title.textContent = "Thanks. Now submit it on GitHub.";
    const opened = "Your check opened on GitHub in a new tab. Submit the issue there.";
    if (kind === "checked") {
      body.textContent = `${opened} Once it is processed, ${name}'s label shows it was checked today, with your GitHub name.`;
    } else {
      const n = `${changed} ${changed === 1 ? "change" : "changes"}`;
      body.textContent = `${opened} Once it is processed, the label shows "A change is waiting for review" until a maintainer confirms your ${n} against the source.`;
    }
    doneView.querySelector<HTMLAnchorElement>("[data-again]")!.href = url;
    const tpl = root.querySelector<HTMLTemplateElement>(`[data-preview-${kind}]`)!;
    preview.replaceChildren(tpl.content.cloneNode(true));
    formView.hidden = true;
    doneView.hidden = false;
    window.scrollTo({ top: 0 });
    title.focus();
  }

  function submit() {
    const list = answers();
    const outcome = checkOutcome(list);
    if (outcome.kind === "empty") {
      emptyErr.hidden = false;
      return;
    }
    const missing = lines.filter((fs) => verdict(fs) === "changed" && !nowInput(fs).value.trim());
    lines.forEach((fs) => setLineError(fs, missing.includes(fs)));
    if (missing.length) {
      nowInput(missing[0]).focus();
      return;
    }

    const link = labelCheckLink(root.dataset.repo!, { tool, lines: checkLines, answers: list, note: note.value });
    if (link.kind === "copy") {
      showCopy(link);
      copyBody.focus();
      return;
    }
    window.open(link.url, "_blank", "noopener");
    showDone(outcome.kind, outcome.changed, link.url);
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    submit();
  });

  doneView.querySelector("[data-reset]")!.addEventListener("click", () => {
    doneView.hidden = true;
    formView.hidden = false;
    formView.querySelector<HTMLElement>("h1")!.focus();
  });
</script>
