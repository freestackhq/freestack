---
/**
 * For coding agents (Agents.dc.html). The skill, the MCP server, an example
 * reply built from real labels, and what the agent can ask.
 *
 * The MCP domain is an open decision (ARCHITECTURE.md), so the address is a
 * marked placeholder until it is chosen.
 */
import Shell from "../layouts/Shell.astro";
import { aisles, catches, tool, toolsInAisle } from "../lib/fresh/catalog";

const REPO = "https://github.com/freestackhq/freestack";
const MCP_URL = "https://[domain]/mcp";

// The example: what the user asks, and which labels the agent looks at.
const db = tool("neon");
const signIn = tool("clerk");
const skipped = tool("vercel-hobby");
const skippedCatch = skipped ? catches().find((c) => c.tool === skipped.id) : undefined;
const instead = skippedCatch?.avoid_with.map((id) => tool(id)).find(Boolean);
const showExample = Boolean(db && signIn);
const bothSell = db?.sell === "yes" && signIn?.sell === "yes";
const dbCatch = db?.catches[0];
const lowerFirst = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);

// Example inputs for each tool, from the catalog.
const firstAisle = aisles()[0];
const compareIds = firstAisle ? toolsInAisle(firstAisle.id).slice(0, 3).map((t) => t.id) : [];
---

<Shell title="For coding agents · freestack" description="Your agent checks these labels before it adds anything paid.">
  <div class="wrap page">
    <h1 class="title">freestack for coding agents</h1>
    <p class="lede">Your agent checks these labels before it adds anything paid, and tells you the catch.</p>

    <div class="install">
      <section class="box" aria-labelledby="i1">
        <h2 id="i1">Install the skill</h2>
        <p class="muted">Claude Code, Cursor, Codex, OpenCode. No setup after this.</p>
        <code class="cmd">npx skills add {REPO}</code>
        <p class="sub">Claude Code plugin</p>
        <code class="cmd">/plugin marketplace add freestackhq/freestack</code>
      </section>
      <section class="box" aria-labelledby="i2">
        <h2 id="i2">Or add the MCP server</h2>
        <p class="muted">Read only, public, no login. Already inside the plugin.</p>
        <code class="cmd">{`{ "mcpServers": { "freestack": {\n  "url": "${MCP_URL}" } } }`}</code>
        <p class="placeholder" data-placeholder-note>
          <strong>[domain]</strong> is a placeholder. The address is not decided yet, so this server is not live.
        </p>
      </section>
    </div>

    {
      showExample && (
        <section class="block" aria-labelledby="ex-h">
          <h2 id="ex-h" class="section-title">What it looks like</h2>
          <div class="chat">
            <div class="turn">
              <p class="who">You</p>
              <p class="said">Add a database and sign-in to my capstone. I might sell it later.</p>
            </div>
            <div class="turn agent">
              <p class="who">Your agent, using freestack</p>
              <p class="said">
                Going with <strong>{db!.name}</strong> for the database and <strong>{signIn!.name}</strong> for sign-in.
                {bothSell ? " Both are free and allow selling." : " Both are free. Check the terms before selling."}
                {dbCatch && (
                  <>
                    <br />
                    Catch: {db!.name} {lowerFirst(dbCatch)}.
                  </>
                )}
                {skipped?.sell === "no" && (
                  <>
                    <br />
                    Skipped <strong>{skipped.name}</strong> for hosting since it does not allow selling.
                    {instead && ` Using ${instead.name} instead.`}
                  </>
                )}
              </p>
            </div>
          </div>
        </section>
      )
    }

    <section class="block" aria-labelledby="tools-h">
      <h2 id="tools-h" class="section-title">What the agent can ask</h2>
      <div class="asks">
        <div class="ask">
          <h3>Find tools</h3>
          <p>Search by aisle and must-haves.</p>
          <code>{`aisle: ${firstAisle?.id ?? "databases"}\nmust: can sell, no card`}</code>
        </div>
        <div class="ask">
          <h3>Compare</h3>
          <p>Up to 4 labels side by side.</p>
          <code>{compareIds.join(", ")}</code>
        </div>
        <div class="ask">
          <h3>Suggest a stack</h3>
          <p>One pick per job for who you are.</p>
          <code>for: student</code>
        </div>
        <div class="ask">
          <h3>Check a stack</h3>
          <p>Flags catches in what you use.</p>
          <code>vercel, supabase, clerk</code>
        </div>
      </div>
    </section>

    <p class="none">
      No install at all? The same data is at <a href="/api/entries">/api/entries</a> and <a href="/llms.txt">/llms.txt</a>.
    </p>
  </div>
</Shell>

<style>
  .page {
    padding-block: 48px 96px;
  }
  .title {
    margin: 0;
    font-weight: 900;
    font-stretch: 62%;
    line-height: 1;
    font-size: clamp(56px, 8vw, 104px);
    max-width: 14ch;
  }
  .lede {
    margin: 14px 0 0;
    max-width: 50ch;
    font-size: 19px;
    line-height: 1.45;
  }
  .install {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 20px;
  }
  .box {
    background: var(--label);
    border: 2px solid var(--ink);
    padding: 24px;
    display: grid;
    gap: 12px;
    align-content: start;
    min-width: 0;
  }
  .box h2 {
    margin: 0;
    font-weight: 900;
    font-stretch: 62%;
    font-size: 36px;
    line-height: 1;
  }
  .box p {
    margin: 0;
    font-size: 15px;
  }
  .box .sub {
    margin-top: 4px;
    font-weight: 700;
  }
  code {
    font-family: var(--font);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .cmd {
    display: block;
    padding: 14px 16px;
    background: var(--ink);
    color: var(--label);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.5;
  }
  .placeholder {
    color: var(--muted);
  }
  .block {
    margin-top: 56px;
  }
  .section-title {
    margin: 0 0 20px;
    font-weight: 900;
    font-stretch: 62%;
    line-height: 1;
    font-size: clamp(40px, 4.5vw, 56px);
  }
  .chat {
    max-width: 820px;
    background: var(--label);
    border: 2px solid var(--ink);
  }
  .turn {
    padding: 18px 22px;
    border-bottom: 1px solid var(--rule);
  }
  .turn.agent {
    background: var(--fill);
    border-bottom: 0;
  }
  .who {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }
  .said {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
  }
  .asks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 16px;
  }
  .ask {
    background: var(--label);
    padding: 20px 22px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .ask h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
  }
  .ask p {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
  }
  .ask code {
    display: block;
    padding: 10px 12px;
    background: var(--fill);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.3;
  }
  .none {
    margin: 40px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .none {
    line-height: 2;
  }
  @media (max-width: 640px) {
    .page {
      padding-block: 32px 64px;
    }
    .box {
      padding: 20px;
    }
  }
</style>
