---
import Layout from "../../layouts/Layout.astro";
import { CATALOGS } from "../../lib/catalog";
---

<Layout
  title="Catalogs · freestack."
  description="Freestack catalogs — self-hosted software, free tools, and more."
>
  <section class="ds-wrap pb-24 pt-[88px] sm:pt-[120px]">
    <h1 class="text-[clamp(2.4rem,6vw,4.5rem)] leading-[1.05] font-bold tracking-[-0.04em] text-ink">
      catalogs<span class="text-ink-3">.</span>
    </h1>
    <p class="mt-4 max-w-xl text-[0.95rem] leading-[1.75] text-ink-2">
      Every catalog here is a Markdown repo under{" "}
      <code class="font-mono text-ink">github.com/freestackhq</code>. This site scrapes them
      at build time and generates these pages. Add a repo to{" "}
      <code class="font-mono text-ink">catalogs.config.mjs</code>, regenerate, done.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        CATALOGS.map((c) => {
          const total = c.categories.reduce((n, cat) => n + cat.entries.length, 0);
          return (
            <a
              href={`/catalogs/${c.id}`}
              class="block rounded-[var(--radius)] border border-b2 bg-s1 p-5 transition-colors hover:border-b1 hover:bg-s2"
            >
              <div class="flex items-baseline justify-between gap-3">
                <h2 class="text-lg font-semibold tracking-tight text-ink">{c.label}</h2>
                <span class="font-mono text-[0.72rem] text-ink-3">{total} entries</span>
              </div>
              <p class="mt-2 text-[0.9rem] leading-relaxed text-ink-2">{c.description}</p>
              <p class="mt-3 font-mono text-[0.7rem] text-ink-3">
                {c.owner}/{c.repo} · {c.categories.length} categories
              </p>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>