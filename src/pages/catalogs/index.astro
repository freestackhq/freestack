---
import Layout from "../../layouts/Layout.astro";
import Directory from "../../components/Directory.astro";
import { CATALOGS } from "../../lib/catalog";

const entryCount = CATALOGS.reduce(
  (count, catalog) => count + catalog.categories.reduce((n, category) => n + category.entries.length, 0),
  0,
);
---

<Layout
  title="Browse developer tools · freestack."
  description="Search and filter free and low-cost developer tools, APIs, and AI services."
>
  <section class="ds-wrap pb-5 pt-[72px] sm:pt-[88px]">
    <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-3">Catalog</p>
    <h1 class="mt-3 text-[clamp(2.4rem,6vw,4.5rem)] leading-[1.05] font-bold tracking-[-0.04em] text-ink">
      Browse tools<span class="text-sand">.</span>
    </h1>
    <p class="mt-4 max-w-xl text-[0.95rem] leading-[1.75] text-ink-2">
      Search and filter {entryCount} entries across SaaS, public APIs, and AI. Check the limits and terms that matter to your project.
    </p>
  </section>
  <Directory defaultCatalog="saas" />
</Layout>
