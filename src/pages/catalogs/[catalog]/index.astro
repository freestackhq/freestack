---
import Layout from "../../../layouts/Layout.astro";
import { CATALOGS } from "../../../lib/catalog";

export function getStaticPaths() {
  return CATALOGS.map((c) => ({ params: { catalog: c.id } }));
}

const { catalog } = Astro.params;
const catalogData = CATALOGS.find((c) => c.id === catalog)!;
const total = catalogData.categories.reduce((n, cat) => n + cat.entries.length, 0);
---

<Layout
  title={`${catalogData.label} · freestack.`}
  description={catalogData.description}
>
  <section class="ds-wrap pb-24 pt-[88px] sm:pt-[120px]">
    <p class="font-mono text-[0.75rem] text-ink-3">
      <a href="/catalogs" class="hover:text-ink-2">catalogs</a> / {catalogData.id}
    </p>
    <h1 class="mt-3 text-[clamp(2.4rem,6vw,4.5rem)] leading-[1.05] font-bold tracking-[-0.04em] text-ink">
      {catalogData.label}<span class="text-ink-3">.</span>
    </h1>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <p class="max-w-2xl text-[0.95rem] leading-[1.75] text-ink-2">{catalogData.description}</p>
      <a
        href={`https://github.com/${catalogData.owner}/${catalogData.repo}`}
        target="_blank"
        rel="noopener noreferrer"
        class="ds-btn ds-btn-outline ml-auto"
        >repo ↗</a
      >
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        catalogData.categories.map((cat) => (
          <a
            href={`/catalogs/${catalogData.id}/${cat.id}`}
            class="block rounded-[var(--radius)] border border-b2 bg-s1 p-5 transition-colors hover:border-b1 hover:bg-s2"
          >
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-base font-semibold tracking-tight text-ink">{cat.label}</h2>
              <span class="font-mono text-[0.72rem] text-ink-3">{cat.entries.length}</span>
            </div>
            <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-2">{cat.description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {cat.entries.slice(0, 5).map((e) => (
                <span class="ds-badge" key={e.slug}>{e.name}</span>
              ))}
              {cat.entries.length > 5 && (
                <span class="ds-badge">+{cat.entries.length - 5}</span>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>