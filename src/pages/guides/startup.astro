---
/**
 * Startup guide: a plain page until it is rewritten (ARCHITECTURE.md, "Old guides").
 * Advice, not label data: the tools it names link to their aisles for the numbers.
 */
import Shell from "../../layouts/Shell.astro";

const acts = [
  {
    num: "01",
    title: "Stay commercial-OK",
    body: "Edu licenses (JetBrains Edu, Figma Education, Autodesk, MATLAB Campus-Wide) are for learning. Production for a company — even a tiny one — needs seats and ToS that allow commercial use. Vercel Hobby is the same trap.",
  },
  {
    num: "02",
    title: "Buy outcomes, not platforms",
    body: "Default to Cloudflare + Neon/Turso + Clerk + Resend + R2 + PostHog. Add a hyperscaler only when you have a concrete reason (GPU batch, compliance region, Activate credits that expire).",
  },
  {
    num: "03",
    title: "AI is a line item — meter it",
    body: "Route drafts through cheap/fast models (Groq, Gemini free quota, Workers AI, OpenRouter free models). Keep Claude/GPT on the hard path. Put Langfuse or Helicone in front before the first customer demo so spend is visible.",
  },
  {
    num: "04",
    title: "Claim startup credits once you are real",
    body: "AWS Activate, Google for Startups, Microsoft for Startups — apply when you have incorporation or an accelerator letter. Burn credits on load tests and GPU jobs, not idle VMs.",
  },
  {
    num: "05",
    title: "Ops stack that doesn't need a COO",
    body: "Cal.com for bookings, Linear for issues, Chatwoot/Crisp for support, Lemon Squeezy or Paddle when you sell globally and hate VAT paperwork. Notion Free until SAML is forced on you.",
  },
];

const leanStack = [
  ["Edge / web", "Cloudflare Pages + Workers (commercial OK)"],
  ["API", "Koyeb micro or Workers — skip always-on beef until traffic"],
  ["DB", "Neon or Turso free → paid when storage wakes you up"],
  ["Auth", "Clerk / Kinde free MAU"],
  ["Email", "Resend free → Pro when deliverability matters"],
  ["Files", "R2 — zero egress for user downloads"],
  ["Jobs", "Inngest free steps"],
  ["Analytics", "PostHog free events"],
  ["LLM gateway", "OpenRouter + spend cap · Helicone/Langfuse"],
  ["Default model", "Gemini / Groq / Workers AI for bulk"],
  ["Frontier model", "Claude or GPT only on tool-critical steps"],
  ["Payments", "Lemon Squeezy / Paddle (MoR) or Stripe when ready"],
];

const aiRules = [
  {
    title: "Cache & dedupe",
    body: "Identical prompts should not hit the API twice. Helicone caching or your own KV on R2/Workers buys real money back.",
  },
  {
    title: "Structured outputs > chat soup",
    body: "JSON schemas and tool calls fail cheaper than free-form prose you re-parse with another model.",
  },
  {
    title: "Eval before scale",
    body: "A 50-row golden set in Langfuse beats vibes. Don't raise temperature and hope.",
  },
  {
    title: "Human in the loop where liability lives",
    body: "Tech-adjacent (health, finance, legal-ish ops): AI drafts, humans approve. Cheaper than one incident.",
  },
];

const phases = [
  {
    num: "0",
    title: "Pre-revenue prototype",
    spend: "~$0–30/mo",
    points: [
      "Free plans that allow selling only (check Can sell on each label)",
      "Student Pack if you still qualify — don't put edu tools in prod",
      "Oracle Always Free or Koyeb micro if you need a long process",
    ],
  },
  {
    num: "1",
    title: "First paying users",
    spend: "~$30–200/mo",
    points: [
      "Turn on spend caps everywhere (OpenAI, Anthropic, OpenRouter, cloud)",
      "Graduate Resend / Clerk / Neon when free limits page you at night",
      "Apply Activate / Google for Startups if incorporated",
    ],
  },
  {
    num: "2",
    title: "Team of 3–10",
    spend: "intentional",
    points: [
      "Linear + shared PostHog + one observability bill (Sentry)",
      "Drop self-host chores that aren't your moat",
      "Revisit Fly/AWS only with a region or compliance story",
    ],
  },
];

const antiRecs = [
  ["Intercom day-0", "Seat pricing arrives before you have customers. Use Chatwoot or Crisp until tickets hurt."],
  [
    "Vercel Hobby in prod",
    "Not for anything that makes money. Use Cloudflare Workers, or paid Vercel once you charge.",
  ],
  ["Edu licenses in prod", "JetBrains, Figma and Autodesk education plans are for school only. Buy seats."],
  [
    "Frontier model by default",
    "Claude or GPT on every request. Cheap or local first; frontier only on the hard steps.",
  ],
  ["Idle cloud-credit VMs", "Credits expire. Spend them on load tests and GPU jobs, not always-on toys."],
];
---

<Shell
  title="Startup lean · freestack"
  description="Ship without a burn narrative: known costs, commercial-safe licenses, metered AI."
>
  <div class="wrap guide">
    <p class="crumbs muted">Guide</p>
    <h1 class="title-lg">Startup lean, without a burn narrative.</h1>
    <p class="lede">
      Known costs, licenses that allow selling, and AI that doesn't melt the card. The limits live on the labels: start
      from <a href="/startup-programs">Startup programs</a>, <a href="/cloud-credits">Cloud credits</a> and{" "}
      <a href="/inference">Inference APIs</a>.
    </p>

    <ol class="rows">
      {acts.map((a) => (
        <li class="row">
          <span class="num muted">{a.num}</span>
          <div>
            <h2>{a.title}</h2>
            <p>{a.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <h2 class="section">A. Default lean stack</h2>
    <p class="muted">Swap pieces freely. Keep every part one that lets you sell.</p>
    <dl class="rows">
      {leanStack.map(([k, v]) => (
        <div class="row">
          <dt class="num muted">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>

    <h2 class="section">B. AI spend rules</h2>
    <div class="grid">
      {aiRules.map((r) => (
        <div class="panel card">
          <h3>{r.title}</h3>
          <p>{r.body}</p>
        </div>
      ))}
    </div>

    <h2 class="section">C. Phases</h2>
    {phases.map((p) => (
      <section class="phase">
        <h3>
          Phase {p.num}: {p.title} <span class="muted">{p.spend}</span>
        </h3>
        <ul>
          {p.points.map((pt) => (
            <li>{pt}</li>
          ))}
        </ul>
      </section>
    ))}

    <h2 class="section">D. Looks free, then eats the company</h2>
    <dl class="rows">
      {antiRecs.map(([k, v]) => (
        <div class="row">
          <dt class="num muted">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>

    <p class="next">
      <a class="btn btn-promo" href="/build?as=startup">
        Build a startup stack
      </a>
      <a class="btn btn-outline" href="/student-programs">
        Claim Once programs
      </a>
    </p>
  </div>
</Shell>

<style>
  .guide {
    padding-block: 40px 80px;
    max-width: calc(880px + 2 * var(--gutter));
  }
  .lede {
    margin: 16px 0 40px;
    font-size: 18px;
    max-width: 62ch;
  }
  .lede a {
    color: var(--ink);
    font-weight: 700;
  }
  .section {
    margin: 56px 0 8px;
    font-size: 22px;
    font-weight: 800;
  }
  .rows {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  .row h2 {
    margin: 0;
    font-size: 18px;
  }
  .row p,
  .row dd {
    margin: 4px 0 0;
  }
  .num {
    font-weight: 700;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  .card {
    padding: 20px;
  }
  .card h3,
  .phase h3 {
    margin: 0;
    font-size: 17px;
  }
  .card p {
    margin: 8px 0 0;
  }
  .phase {
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  .phase ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
