---
import "../design-system/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "freestack.",
  description = "Find free and low-cost tools for your project. Compare limits, eligibility, commercial terms, and alternatives.",
} = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0c0b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='5' fill='%230d0c0b'/%3E%3Ctext x='50%25' y='56%25' dominant-baseline='middle' text-anchor='middle' font-size='11' font-family='monospace' fill='%23c4a882'%3Efs%3C/text%3E%3C/svg%3E"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh flex flex-col">
    <nav
      id="nav"
      class="fixed inset-x-0 top-0 z-50 h-[var(--nav-h)] border-b border-transparent transition-[background,border-color] duration-200"
    >
      <div class="ds-wrap flex h-full items-center justify-between">
        <a href="/" class="font-semibold tracking-tight text-ink" aria-label="Freestack home">freestack<span class="text-sand">.</span></a>
        <div id="nav-links" class="hidden items-center gap-1.5 sm:flex">
          <a href="/#paths" class="rounded-md px-2.5 py-1 text-[0.8rem] text-ink-2 transition-colors hover:bg-s1 hover:text-ink">Paths</a>
          <a href="/catalogs" class:list={["rounded-md px-2.5 py-1 text-[0.8rem] transition-colors", path.startsWith("/catalogs") ? "text-ink" : "text-ink-2 hover:bg-s1 hover:text-ink"]}>Catalog</a>
          <a href="/docs" class:list={["rounded-md px-2.5 py-1 text-[0.8rem] transition-colors", path.startsWith("/docs") ? "text-ink" : "text-ink-2 hover:bg-s1 hover:text-ink"]}>API</a>
        </div>
        <button
          id="nav-toggle"
          type="button"
          class="flex flex-col gap-1 p-1 sm:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="block h-[1.5px] w-[18px] rounded bg-ink-2"></span>
          <span class="block h-[1.5px] w-[18px] rounded bg-ink-2"></span>
          <span class="block h-[1.5px] w-[18px] rounded bg-ink-2"></span>
        </button>
      </div>
    </nav>

    <div
      id="mobile-nav"
      aria-hidden="true"
      class="fixed inset-0 z-[90] hidden flex-col items-center justify-center gap-7 bg-bg"
    >
      <button
        id="nav-close"
        type="button"
        class="absolute top-[18px] right-6 text-[1.1rem] text-ink-3"
        aria-label="Close">✕</button
      >
      <a href="/#paths" class="text-2xl font-semibold text-ink-2">Paths</a>
      <a href="/catalogs" class="text-2xl font-semibold text-ink-2">Catalog</a>
      <a href="/docs" class="text-2xl font-semibold text-ink-2">API</a>
    </div>

    <main class="flex-1 pt-[var(--nav-h)]">
      <slot />
    </main>

    <footer class="border-t border-b1 py-10">
      <div
        class="ds-wrap flex flex-col gap-3 text-[0.8rem] text-ink-3 sm:flex-row sm:items-start sm:justify-between"
      >
        <div class="max-w-lg">
          <p>Offers and limits change. Check provider terms before relying on a free plan.</p>
        </div>
        <div class="shrink-0 space-y-2 sm:text-right">
          <p class="font-mono">
            freestack<em class="not-italic">.</em> · not affiliated with any vendor
          </p>
          <p class="font-mono">
            <a
              href="/docs"
              class:list={[
                "underline-offset-2 hover:underline",
                path.startsWith("/docs") ? "text-ink" : "text-ink-2 hover:text-ink",
              ]}>api</a
            >
            {" "}·{" "}
            <a
              href="https://github.com/kuyacarlo/awesome-freestack"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-2 underline-offset-2 hover:text-ink hover:underline"
              >awesome list ↗</a
            >
          </p>
        </div>
      </div>
    </footer>

    <script>
      const nav = document.getElementById("nav");
      const navLinks = document.getElementById("nav-links");
      const filtersBar = document.getElementById("filters");
      const searchRow = filtersBar?.querySelector<HTMLElement>(".relative.flex");
      const mobile = window.matchMedia("(min-width: 640px)");
      let searchDocked = false;
      let searchHome: HTMLElement | null = null;

      const dockSearch = (on: boolean) => {
        if (!searchRow || !navLinks) return;
        if (on && !searchDocked && mobile.matches) {
          searchHome = searchRow.parentElement;
          searchRow.classList.add("flex-1");
          navLinks.before(searchRow);
          searchDocked = true;
        } else if (!on && searchDocked && searchHome) {
          searchHome.prepend(searchRow);
          searchRow.classList.remove("flex-1");
          searchDocked = false;
        }
      };

      const onScroll = () => {
        const navH = nav?.offsetHeight ?? 0;
        const filtersStuck = filtersBar
          ? filtersBar.getBoundingClientRect().top <= navH + 1
          : false;
        dockSearch(filtersStuck);
        if (!nav) return;
        const isHome = window.location.pathname === "/";
        const scrolled = window.scrollY > 8;
        if (scrolled) {
          if (!isHome) {
            nav.classList.add("border-b1");
            nav.classList.remove("border-transparent");
          }
          nav.classList.add("bg-[#0d0c0be0]", "backdrop-blur-[14px]");
        } else {
          nav.classList.remove("border-b1", "bg-[#0d0c0be0]", "backdrop-blur-[14px]");
          nav.classList.add("border-transparent");
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      const open = document.getElementById("nav-toggle");
      const close = document.getElementById("nav-close");
      const drawer = document.getElementById("mobile-nav");
      const setDrawer = (isOpen: boolean) => {
        if (!drawer || !open) return;
        drawer.classList.toggle("hidden", !isOpen);
        drawer.classList.toggle("flex", isOpen);
        drawer.setAttribute("aria-hidden", String(!isOpen));
        open.setAttribute("aria-expanded", String(isOpen));
        if (isOpen) drawer.querySelector<HTMLAnchorElement>("a")?.focus();
        else open.focus();
      };
      open?.addEventListener("click", () => setDrawer(true));
      close?.addEventListener("click", () => setDrawer(false));
      drawer?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setDrawer(false)));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && drawer && !drawer.classList.contains("hidden")) setDrawer(false);
      });
    </script>
  </body>
</html>
