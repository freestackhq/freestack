---
/**
 * Plain reading page (Privacy, Terms, Contact): a condensed title, an optional
 * "Updated" date and a narrow column of text on a white panel. No board for
 * these; built from the shell, the tokens and the 404/500 type scale.
 */
import Shell from "./Shell.astro";

interface Props {
  title: string;
  description: string;
  lede?: string;
  /** ISO date the text last changed, shown as "Updated 18 Nov 2026". */
  updated?: string;
}

const { title, description, lede, updated } = Astro.props;
const updatedText = updated
  ? new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    })
  : null;
---

<Shell title={`${title} · freestack`} description={description}>
  <div class="wrap page">
    <h1 class="title-lg">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    {updatedText && (
      <p class="updated">
        Updated <time datetime={updated}>{updatedText}</time>
      </p>
    )}
    <div class="text">
      <slot />
    </div>
  </div>
</Shell>

<style>
  .page {
    padding-block: 3.5rem 7.5rem;
  }
  .lede {
    margin: 1rem 0 0;
    max-width: 52ch;
    font-size: 1.25rem;
    line-height: 1.45;
  }
  .updated {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .text {
    margin-top: 2rem;
    max-width: 45rem;
    background: var(--label);
    padding: 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  /* Slotted content: headings, paragraphs, lists and links. */
  .text :global(h2) {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .text :global(h2:first-child) {
    margin-top: 0;
  }
  .text :global(p),
  .text :global(ul) {
    margin: 0 0 0.75rem;
  }
  .text :global(:last-child) {
    margin-bottom: 0;
  }
  .text :global(ul) {
    padding-left: 1.375rem;
  }
  .text :global(li) {
    margin-bottom: 0.5rem;
  }
  .text :global(a) {
    font-weight: 700;
  }
  @media (max-width: 40rem) {
    .page {
      padding-block: 2rem 4.5rem;
    }
    .lede {
      font-size: 1.125rem;
    }
    .text {
      padding: 1.25rem 1rem;
      font-size: 1rem;
    }
  }
</style>
