# Copy to .env (never committed) or set in CI / the deploy shell.

# The site's public origin. Share links, llms.txt, the API docs, the MCP URL
# and the Workers custom domain all come from this. Required for `pnpm deploy:cf`.
SITE_URL=https://freestack.example.com

# owner/name of the GitHub repo that holds data/ and takes Check a label and
# Add a tool issues. Defaults to freestackhq/freestack.
PUBLIC_GITHUB_REPO=freestackhq/freestack

# Support address shown on /contact and /privacy (e.g. support@your.domain).
# Leave empty and those pages point to GitHub issues only. Set it before launch.
PUBLIC_CONTACT_EMAIL=

# Cloudflare Web Analytics beacon token. Leave empty to ship no analytics.
PUBLIC_CF_ANALYTICS_TOKEN=
